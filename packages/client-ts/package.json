{
  "name": "@ovis-terminal/client",
  "version": "0.1.0",
  "private": true,
  "description": "OpenRPC-generated TypeScript types and persistent Bun client for ovis-terminal.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/devswha/ovis-terminal.git",
    "directory": "packages/client-ts"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/types/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./openrpc.json": "./dist/openrpc.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check",
    "build": "bun scripts/build.ts",
    "pack": "bun scripts/pack.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "5"
  }
}

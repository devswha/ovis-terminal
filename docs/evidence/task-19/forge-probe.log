$ probe: clone an owned Session (a reference copy compiles; an owned copy must not)
fn copy(session: &ovis_terminal_authz::Session) -> ovis_terminal_authz::Session { session.clone() }
error[E0308]: mismatched types
note: `Session` does not implement `Clone`, so `&Session` was cloned instead
EXIT=101


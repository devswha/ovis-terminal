$ probe: forge a Decision literal
fn forge() -> ovis_terminal_authz::Decision<ovis_terminal_core::registry::RegistryIdentities> { ovis_terminal_authz::Decision { authority: todo!(), claim: todo!(), principal: todo!(), action: todo!(), target: todo!() } }

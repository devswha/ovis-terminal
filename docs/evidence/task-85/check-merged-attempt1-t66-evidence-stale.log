 active when this record was last written.\"},\"build\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/VerifiedBuild\"},{\"type\":\"null\"}],\"description\":\"Verified build facts; absent until verification passes.\"},\"rejection\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/UpdateRejection\"},{\"type\":\"null\"}],\"description\":\"Why it was rejected, when it was.\"},\"rollback\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/RollbackReceipt\"},{\"type\":\"null\"}],\"description\":\"Latest rollback, when one happened.\"},\"sha256\":{\"$ref\":\"#/components/schemas/Sha256Digest\",\"description\":\"Digest of the staged release archive.\"},\"staged_by\":{\"$ref\":\"#/components/schemas/OpId\",\"description\":\"Operation that staged it.\"},\"state\":{\"$ref\":\"#/components/schemas/UpdateState\",\"description\":\"Progress.\",\"x-ovis-open-enum\":true},\"target\":{\"$ref\":\"#/components/schemas/BuildTarget\",\"description\":\"Target the build runs on.\"},\"update_id\":{\"$ref\":\"#/components/schemas/UpdateId\",\"description\":\"Update identity.\"},\"version\":{\"$ref\":\"#/components/schemas/ReleaseVersion\",\"description\":\"Target build version.\"}},\"required\":[\"update_id\",\"version\",\"target\",\"sha256\",\"state\",\"active_version\",\"staged_by\"],\"type\":\"object\"},\"UpdateRejection\":{\"additionalProperties\":false,\"description\":\"A rejection and the operation that found it.\",\"properties\":{\"op_id\":{\"$ref\":\"#/components/schemas/OpId\",\"description\":\"The operation that found it.\"},\"reason\":{\"$ref\":\"#/components/schemas/RejectReason\",\"description\":\"What failed.\",\"x-ovis-open-enum\":true}},\"required\":[\"reason\",\"op_id\"],\"type\":\"object\"},\"UpdateStageParams\":{\"additionalProperties\":false,\"description\":\"Parameters of `update.stage`.\",\"properties\":{\"op_id\":{\"$ref\":\"#/components/schemas/OpId\",\"description\":\"Client-minted operation identity.\"},\"sha256\":{\"$ref\":\"#/components/schemas/Sha256Digest\",\"description\
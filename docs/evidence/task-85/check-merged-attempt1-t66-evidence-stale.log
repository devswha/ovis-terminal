iated protocol generation.\"},\"limits\":{\"$ref\":\"#/components/schemas/Limits\",\"description\":\"Advertised limits.\"},\"machine_id\":{\"$ref\":\"#/components/schemas/MachineId\",\"description\":\"Stable machine identity.\"},\"methods\":{\"description\":\"Methods this build implements; never a method it would refuse.\",\"items\":{\"$ref\":\"#/components/schemas/MethodName\"},\"type\":\"array\"},\"runtime_lifetime\":{\"$ref\":\"#/components/schemas/RuntimeLifetimeId\",\"description\":\"Holder-supervisor lifetime.\"},\"server_boot_id\":{\"$ref\":\"#/components/schemas/ServerBootId\",\"description\":\"Control-server boot identity.\"},\"server_time_ms\":{\"$ref\":\"#/components/schemas/TimestampMs\",\"description\":\"Server clock.\"},\"version\":{\"$ref\":\"#/components/schemas/BuildVersion\",\"description\":\"Runtime build version.\"}},\"required\":[\"machine_id\",\"runtime_lifetime\",\"server_boot_id\",\"generation\",\"version\",\"methods\",\"capabilities\",\"limits\",\"server_time_ms\",\"endpoint_kind\"],\"type\":\"object\"},\"HistoryChange\":{\"description\":\"What an observation found different from the recorded history.\",\"oneOf\":[{\"const\":\"append\",\"description\":\"Records were added after the recorded content, which is unchanged.\",\"type\":\"string\"},{\"const\":\"truncate\",\"description\":\"The source is shorter than the recorded content.\",\"type\":\"string\"},{\"const\":\"replace\",\"description\":\"The source is a different file than the one recorded.\",\"type\":\"string\"},{\"const\":\"rewrite\",\"description\":\"Recorded bytes changed in place, including rewrites that keep the size.\",\"type\":\"string\"},{\"const\":\"branch\",\"description\":\"The active chain was selected explicitly by the owning process.\",\"type\":\"string\"},{\"const\":\"rebind\",\"description\":\"The binding moved to another history identity.\",\"type\":\"string\"}]},\"HistoryGap\":{\"description\":\"Why history is not available.\",\"oneOf\":[{\"const\":\"alt_screen\",\"d
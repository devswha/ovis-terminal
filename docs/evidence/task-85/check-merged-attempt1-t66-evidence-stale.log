.\",\"oneOf\":[{\"const\":\"cancelled_before_commit\",\"description\":\"No effect was permitted.\",\"type\":\"string\"},{\"const\":\"already_committed\",\"description\":\"The committed outcome cannot be undone.\",\"type\":\"string\"},{\"const\":\"pending\",\"description\":\"Work may have begun; inspect the operation rather than replaying it.\",\"type\":\"string\"},{\"const\":\"cancel_pending\",\"description\":\"Cancellation reached the request before its durable accept, which then committed\\nas cancelled; no effect was permitted and the request itself settles `cancelled`.\",\"type\":\"string\"}]},\"Capabilities\":{\"description\":\"Features this runtime serves; a client never assumes an absent entry.\",\"properties\":{\"framed\":{\"description\":\"Whether `hello` may upgrade the connection to framed mode.\",\"type\":\"boolean\"},\"stream_modes\":{\"description\":\"Attach stream delivery modes.\",\"items\":{\"$ref\":\"#/components/schemas/StreamMode\",\"x-ovis-open-enum\":true},\"type\":\"array\"},\"transports\":{\"description\":\"Transports this endpoint serves.\",\"items\":{\"$ref\":\"#/components/schemas/TransportKind\",\"x-ovis-open-enum\":true},\"type\":\"array\"}},\"required\":[\"transports\",\"stream_modes\",\"framed\"],\"type\":\"object\"},\"CensusState\":{\"description\":\"Whether a status answer carries a holder and terminal census.\",\"oneOf\":[{\"const\":\"reported\",\"description\":\"The terminal service published `holder_count` and `live_terminals`.\",\"type\":\"string\"},{\"const\":\"not_reported\",\"description\":\"Nothing published a census; both counts are null rather than zero.\",\"type\":\"string\"}]},\"CheckoutId\":{\"description\":\"Opaque identity string.\",\"type\":\"string\"},\"Checkpoint\":{\"description\":\"Offset-fenced checkpoint that precedes live bytes on a stream.\",\"properties\":{\"cursor\":{\"$ref\":\"#/components/schemas/ScreenCursor\",\"description\":\"Cursor state.\"},\"geometry\":{\"$ref\":\"#/components/schemas/Geometry\",\"description\":\"Grid size.\"},\"history_lines\":{\"$ref\":\"#/components/schemas/Count\",\"description\":\"Primary-screen history lines readable behind the paint: the history cursor.\"},\"modes\":{\"$ref\":\"#/components/schemas/Modes\",\"description\":\"Terminal modes.\"},\"output_offset\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Raw output offset the checkpoint represents.\"},\"revision\":{\"$ref\":\"#/components/schemas/Revision\",\"description\":\"Screen revision.\"},\"stream_offset\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Filtered stream offset where the checkpoint bytes begin.\"}},\"required\":[\"output_offset\",\"stream_offset\",\"revision\",\"geometry\",\"modes\",\"cursor\",\"history_lines\"],\"type\":\"object\"},\"ChildPolicy\":{\"additionalProperties\":false,\"description\":\"How a child relates to its parent incarnation.\",\"properties\":{\"die_with_parent\":{\"description\":\"End this child when the parent incarnation finishes.\",\"type\":\"boolean\"},\"notify\":{\"description\":\"Deliver child news to the parent as notes.\",\"type\":\"boolean\"}},\"required\":[\"notify\",\"die_with_parent\"],\"type\":\"object\"},\"ChildRecord\":{\"description\":\"One child of a parent incarnation.\",\"properties\":{\"process_incarnation\":{\"$ref\":\"#/components/schemas/Incarnation\",\"description\":\"Child program incarnation.\"},\"status\":{\"$ref\":\"#/components/schemas/StatusSnapshot\",\"description\":\"Child's declared status.\"},\"terminal_id\":{\"$ref\":\"#/components/schemas/TerminalId\",\"description\":\"Child terminal.\"},\"unseen_news\":{\"description\":\"Unacknowledged news from this child.\",\"format\":\"uint32\",\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"terminal_id\",\"process_incarnation\",\"status\",\"unseen_news\"],\"type\":\"object\"},\"ChildWaitMode\":{\"description\":\"When `agent.wait_children` returns.\",\"oneOf\":[{\"const\":\"any\",\"description\":\"On the first news from any child.\",\"type\":\"string\"},{\"const\":\"all\",\"description\":\"When every child has stopped.\",\"type\":\"string\"}]},\"ClientId\":{\"description\":\"Opaque identity string.\",\"type\":\"string\"},\"ClientInfo\":{\"additionalProperties\":false,\"description\":\"Client identity presented in `hello`.\",\"properties\":{\"name\":{\"description\":\"Client program name.\",\"type\":\"string\"},\"version\":{\"description\":\"Client program version.\",\"type\":\"string\"}},\"required\":[\"name\",\"version\"],\"type\":\"object\"},\"CloseScope\":{\"description\":\"Destructive scope a close request explicitly accepts.\",\"oneOf\":[{\"const\":\"target\",\"description\":\"Only the named resource; refuse if others would be affected.\",\"type\":\"string\"},{\"const\":\"group\",\"description\":\"The named resource and its linked group.\",\"type\":\"string\"}]},\"CommitRace\":{\"description\":\"Where a write queued under a withdrawn credential ended up.\",\"oneOf\":[{\"additionalProperties\":false,\"description\":\"Rechecked before its write; no byte reached the program.\",\"properties\":{\"outcome\":{\"const\":\"cancelled_before_commit\",\"type\":\"string\"},\"reason\":{\"$ref\":\"#/components/schemas/FenceToken\",\"description\":\"Why the write was withheld.\"}},\"required\":[\"outcome\",\"reason\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"The holder had already written these bytes before the withdrawal.\",\"properties\":{\"outcome\":{\"const\":\"already_committed\",\"type\":\"string\"},\"output_offset\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Output offset the holder saw when the write started.\"},\"written_bytes\":{\"$ref\":\"#/components/schemas/ByteCount\",\"description\":\"Bytes the holder wrote.\"}},\"required\":[\"outcome\",\"written_bytes\",\"output_offset\"],\"type\":\"object\"},{\"additionalProperties\":false,\"description\":\"The write is with the holder and its fence is not answered yet; it is never resent.\",\"properties\":
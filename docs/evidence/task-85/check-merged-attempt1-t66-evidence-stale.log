 on a stream.\",\"properties\":{\"cursor\":{\"$ref\":\"#/components/schemas/ScreenCursor\",\"description\":\"Cursor state.\"},\"geometry\":{\"$ref\":\"#/components/schemas/Geometry\",\"description\":\"Grid size.\"},\"history_lines\":{\"$ref\":\"#/components/schemas/Count\",\"description\":\"Primary-screen history lines readable behind the paint: the history cursor.\"},\"modes\":{\"$ref\":\"#/components/schemas/Modes\",\"description\":\"Terminal modes.\"},\"output_offset\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Raw output offset the checkpoint represents.\"},\"revision\":{\"$ref\":\"#/components/schemas/Revision\",\"description\":\"Screen revision.\"},\"stream_offset\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Filtered stream offset where the checkpoint bytes begin.\"}},\"required\":[\"output_offset\",\"stream_offset\",\"revision\",\"geometry\",\"modes\",\"cursor\",\"history_lines\"],\"type\":\"object\"},\"ChildPolicy\":{\"additionalProperties\":false,\"description\":\"How a child relates to its parent incarnation.\",\"properties\":{\"die_with_parent\":{\"description\":\"End this child when the parent incarnation finishes.\",\"type\":\"boolean\"},\"notify\":{\"description\":\"Deliver child news to the parent as notes.\",\"type\":\"boolean\"}},\"required\":[\"notify\",\"die_with_parent\"],\"type\":\"object\"},\"ChildRecord\":{\"description\":\"One child of a parent incarnation.\",\"properties\":{\"process_incarnation\":{\"$ref\":\"#/components/schemas/Incarnation\",\"description\":\"Child program incarnation.\"},\"status\":{\"$ref\":\"#/components/schemas/StatusSnapshot\",\"description\":\"Child's declared status.\"},\"terminal_id\":{\"$ref\":\"#/components/schemas/TerminalId\",\"description\":\"Child terminal.\"},\"unseen_news\":{\"description\":\"Unacknowledged news from this child.\",\"format\":\"uint32\",\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"terminal_id\",\"process_incarnation\",\"status\",\"unseen_news
carnation\",\"description\":\"Program incarnation that opened it.\"},\"prompt_id\":{\"$ref\":\"#/components/schemas/PromptId\",\"description\":\"Prompt identity.\"},\"session\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/SessionRef\"},{\"type\":\"null\"}],\"description\":\"Provider session of that agent, when declared.\"},\"state\":{\"$ref\":\"#/components/schemas/PromptState\",\"description\":\"State.\",\"x-ovis-open-enum\":true},\"terminal_id\":{\"$ref\":\"#/components/schemas/TerminalId\",\"description\":\"Terminal.\"},\"text\":{\"description\":\"Question text.\",\"type\":\"string\"},\"version\":{\"$ref\":\"#/components/schemas/RecordVersion\",\"description\":\"Version; answers must name it.\"}},\"required\":[\"prompt_id\",\"version\",\"terminal_id\",\"process_incarnation\",\"kind\",\"text\",\"choices\",\"fields\",\"mechanism\",\"state\",\"opened_seq\"],\"type\":\"object\"},\"PromptState\":{\"description\":\"State of a prompt.\",\"oneOf\":[{\"const\":\"open\",\"description\":\"Awaiting an answer.\",\"type\":\"string\"},{\"const\":\"answered\",\"description\":\"Answered.\",\"type\":\"string\"},{\"const\":\"dismissed\",\"description\":\"Dismissed.\",\"type\":\"string\"},{\"const\":\"expired\",\"description\":\"Expired with its program incarnation.\",\"type\":\"string\"}]},\"ProofMac\":{\"description\":\"Keyed proof of credential possession, 32 bytes as lowercase hexadecimal.\",\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"ProtocolGeneration\":{\"description\":\"ProtocolGeneration carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"Provenance\":{\"description\":\"What a conversation read consulted before finding nothing structured.\",\"properties\":{\"agent_id\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/AgentId\"},{\"type\":\"null\"}],\"description\":\"Agent of the terminal's current program; null for a plain program.\"},\"session\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/SessionRef\"},{\"type\":\"null\"}],\"description\":\"Session that agent declared, when it declared one.\"},\"source\":{\"$ref\":\"#/components/schemas/ConversationSource\",\"description\":\"The source that was read.\",\"x-ovis-open-enum\":true}},\"required\":[\"source\"],\"type\":\"object\"},\"QueuePosition\":{\"description\":\"QueuePosition carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RacedWrite\":{\"description\":\"One write raced by a withdrawal: its admission receipt and its fate.\",\"properties\":{\"admitted_bytes\":{\"$ref\":\"#/components/schemas/ByteCount\",\"description\":\"Bytes admitted.\"},\"op_id\":{\"$ref\":\"#/components/schemas/OpId\",\"description\":\"Operation that admitted the write.\"},\"queued_seq\":{\"$ref\":\"#/components/schemas/EventSeq\",\"description\":\"Its position in the terminal's input sequence.\"},\"race\":{\"$ref\":\"#/components/schemas/CommitRace\",\"description\":\"What happened to them.\"}},\"required\":[\"op_id\",\"queued_seq\",\"admitted_bytes\",\"race\"],\"type\":\"object\"},\"ReadinessContract\":{\"description\":\"How a launched program proves it can take its first message.\\n\\nOnly a declaration by the program counts; output silence is never readiness.\",\"oneOf\":[{\"additionalProperties\":false,\"description\":\"The program declares one of `states` through OSC 7501 or `status.report`.\",\"properties\":{\"by\":{\"const\":\"declared\",\"type\":\"string\"},\"states\":{\"description\":\"Declared states that release the first message.\",\"items\":{\"$ref\":\"#/components/schemas/AgentState\",\"x-ovis-open-enum\":true},\"type\":\"array\"}},\"required\":[\"by\",\"states\"],\"type\":\"object\"}]},\"ReadinessEvidence\":{\"additionalProperties\":false,\"description\":\"Probe outcome and the bounded output that supports it.\",\"properties\":{\"exit_code\":{\"description\":\"Exit status, when the probe exited with one; absent for a signal or no exit.\",\"format\":\"int32\",\"type\":[\"integer\",\"null\"]},\"outcome\":{\"$ref\":\"#/components/schemas/ProbeOutcome\",\"description\":\"How the probe ended.\",\"x-ovis-open-enum\":true},\"stdout\":{\"description\":\"Leading standard output, lossily decoded and bounded.\",\"type\":\"string\"}},\"required\":[\"outcome\",\"stdout\"],\"type\":\"object\"},\"RecordBlock\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/ContentBlock\",\"description\":\"A block of the typed record contract; every reported record carries only these.\"},{\"description\":\"A transcript block outside the typed contract, unchanged.\"}],\"description\":\"A record block: typed, or provider content a transcript carried as it was.\"},\"RecordCount\":{\"description\":\"RecordCount carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RecordId\":{\"description\":\"Opaque identity string.\",\"type\":\"string\"},\"RecordInput\":{\"additionalProperties\":false,\"description\":\"One record as the owning process reports it.\",\"properties\":{\"at_ms\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/TimestampMs\"},{\"type\":\"null\"}],\"description\":\"Time the provider recorded for the record, when it recorded one.\"},\"blocks\":{\"description\":\"Content blocks in provider order, text and tool results side by side.\",\"items\":{\"$ref\":\"#/components/schemas/ContentBlock\"},\"type\":\"array\"},\"phase\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/MessagePhase\"},{\"type\":\"null\"}],\"description\":\"Phase of assistant text, when the provider recorded one.\"},\"record_id\":{\"$ref\":\"#/components/schemas/RecordId\",\"description\":\"Record identity, unique within the agent's records.\"},\"role\":{\"$ref\":\"#/components/schemas/RecordRole\",\"description\":\"Who the record speaks for.\"}},\"required\":[\"record_id\",\"role\",\"blocks\"],\"type\":\"object\"},\"RecordPosition\":{\"description\":\"RecordPosition carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RecordRole\":{\"description\":\"Who a record speaks for.\",\"oneOf\":[{\"const\":\"user\",\"description\":\"The person driving the agent; text and tool results.\",\"type\":\"string\"},{\"const\":\"assistant\",\"description\":\"The agent; text and tool calls.\",\"type\":\"string\"},{\"const\":\"tool\",\"description\":\"A tool's own record; tool results only.\",\"type\":\"string\"}]},\"RecordVersion\":{\"description\":\"RecordVersion carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RecordsAppended\":{\"description\":\"Payload of `agent.records_appended` and result of `agent.append_records`.\\n\\nIt names the appended records by identity, count and digest; their bodies are read\\nwith `agent.records`, so the receipt stays small whatever the records hold.\",\"properties\":{\"agent_id\":{\"$ref\":\"#/components/schemas/AgentId\",\"description\":\"Agent whose records grew.\"},\"digest\":{\"$ref\":\"#/components/schemas/RecordsDigest\",\"description\":\"`sha256:` over the stored encodings of the appended records, concatenated in order;\\nthe wire reply of `agent.records` is a different serialization.\"},\"first_position\":{\"$ref\":\"#/components/schemas/RecordPosition\",\"description\":\"Position of the first appended record.\"},\"history_id\":{\"$ref\":\"#/components/schemas/HistoryId\",\"description\":\"Identity of the agent's record history.\"},\"process_incarnation\":{\"$ref\":\"#/components/schemas/Incarnation\",\"description\":\"Program incarnation that reported them.\"},\"record_ids\":{\"description\":\"Identities of the appended records, in order.\",\"items\":{\"$ref\":\"#/components/schemas/RecordId\"},\"type\":\"array\"},\"revision\":{\"$ref\":\"#/components/schemas/HistoryRevision\",\"description\":\"History revision after the append.\"},\"total_bytes\":{\"$ref\":\"#/components/schemas/ByteCount\",\"description\":\"Stored bytes of the agent's records after the append.\"},\"total_records\":{\"$ref\":\"#/components/schemas/RecordCount\",\"description\":\"Records the agent holds after the append.\"},\"turns\":{\"description\":\"Turns the appended records or metadata belong to.\",\"items\":{\"$ref\":\"#/components/schemas/ConversationTurn\"},\"type\":\"array\"}},\"required\":[\"agent_id\",\"process_incarnation\",\"history_id\",\"revision\",\"record_ids\",\"first_position\",\"total_records\",\"total_bytes\",\"digest\",\"turns\"],\"type\":\"object\"},\"RecordsDigest\":{\"description\":\"`sha256:` and the lowercase hex SHA-256 of the appended records' stored encoding.\",\"type\":\"string\"},\"RecoveryEvidence\":{\"description\":\"One recorded recovery fact; reads never clear it.\",\"properties\":{\"gaps\":{\"description\":\"Sequence ranges that could not be recovered.\",\"items\":{\"$ref\":\"#/components/schemas/EventSeq\"},\"type\":\"array\"},\"recorded_ms\":{\"$ref\":\"#/components/schemas/TimestampMs\",\"description\":\"Time the evidence was recorded.\"},\"restored\":{\"description\":\"Restored or relaunched terminal incarnations.\",\"items\":{\"$ref\":\"#/components/schemas/Incarnation\"},\"type\":\"array\"},\"server_boot_id\":{\"$ref\":\"#/components/schemas/ServerBootId\",\"description\":\"Boot the evidence belongs to.\"}},\"required\":[\"server_boot_id\",\"restored\",\"gaps\",\"recorded_ms\"],\"type\":\"object\"},\"RecoveryPhase\":{\"description\":\"Summary of what recovery found; reading it never clears it.\",\"oneOf\":[{\"const\":\"clean\",\"description\":\"No recovery and no incident was ever recorded.\",\"type\":\"string\"},{\"const\":\"recovered\",\"description\":\"This lifetime recovered or recorded incidents, and every terminal is settled.\",\"type\":\"string\"},{\"const\":\"degraded\",\"description\":\"Damaged material was recorded or a terminal's survival is still unknown.\",\"type\":\"string\"}]},\"RecoveryState\":{\"additionalProperties\":false,\"description\":\"Recovery state of the runtime, durable across reads.\",\"properties\":{\"corrupted\":{\"description\":\"Damaged database, journal or checkpoint material was recorded.\",\"type\":\"boolean\"},\"incidents\":{\"$ref\":\"#/components/schemas/Count\",\"description\":\"Recorded incidents and quarantined store material.\"},\"phase\":{\"$ref\":\"#/components/schemas/RecoveryPhase\",\"description\":\"Overall phase.\",\"x-ovis-open-enum\":true},\"unsettled\":{\"$ref\":\"#/components/schemas/Count\",\"description\":\"Terminals whose program survival is still unknown.\"}},\"required\":[\"phase\",\"corrupted\",\"incidents\",\"unsettled\"],\"type\":\"object\"},\"RejectReason\":{\"description\":\"Why a staged update was rejected; the active build is unchanged.\",\"oneOf\":[{\"const\":\"digest_mismatch\",\"description\":\"The staged archive no longer hashes to the requested digest.\",\"type\":\"string\"},{\"const\":\"unsafe_archive\",\"description\":\"An archive entry is absolute, escapes the build directory, is a link or repeats.\",\"type\":\"string\"},{\"const\":\"missing_entry\",\"description\":\"The archive lacks `build.json` or the executable.\",\"type\":\"string\"},{\"const\":\"manifest_mismatch\",\"description\":\"`build.json` names another version or target than was staged.\",\"type\":\"string\"},{\"const\":\"protocol_incompatible\",\"description\":\"The build does not serve this runtime's client protocol generation.\",\"type\":\"string\"},{\"const\":\"holder_incompatible\",\"description\":\"The build cannot adopt the running holders' wire generation.\",\"type\":\"string\"}]},\"ReleaseVersion\":{\"pattern\":\"^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$\",\"type\":\"string\"},\"RemoveScope\":{\"additionalProperties\":false,\"description\":\"Destructive scope `worktree.remove` explicitly accepts.\",\"properties\":{\"force\":{\"description\":\"Remove even when dirty or locked.\",\"type\":\"boolean\"},\"group\":{\"description\":\"Also close linked workspaces.\",\"type\":\"boolean\"}},\"required\":[\"group\",\"force\"],\"type\":\"object\"},\"RemovedData\":{\"description\":\"Data of `terminal.removed`.\",\"properties\":{\"tombstone_seq\":{\"$ref\":\"#/components/schemas/EventSeq\",\"description\":\"Sequence of the tombstone.\"}},\"required\":[\"tombstone_seq\"],\"type\":\"object\"},\"ReportSeq\":{\"description\":\"ReportSeq carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RepositoryId\":{\"description\":\"Opaque identity string.\",\"type\":\"string\"},\"ResizeOutcome\":{\"description\":\"Outcome of a resize request.\",\"oneOf\":[{\"const\":\"applied\",\"description\":\"The new grid was applied.\",\"type\":\"string\"},{\"const\":\"unchanged\",\"description\":\"The grid already had this size.\",\"type\":\"string\"},{\"const\":\"superseded\",\"description\":\"A later resize superseded this one.\",\"type\":\"string\"}]},\"RestartingData\":{\"description\":\"Data of `terminal.restarting`.\",\"properties\":{\"attempt\":{\"description\":\"Attempt number.\",\"format\":\"uint32\",\"minimum\":0,\"type\":\"integer\"},\"next_try_ms\":{\"$ref\":\"#/components/schemas/DurationMs\",\"description\":\"Delay before the attempt.\"}},\"required\":[\"attempt\",\"next_try_ms\"],\"type\":\"object\"},\"RetryBoundary\":{\"description\":\"An actionable retry boundary: which event to wait for, never a blind poll.\",\"properties\":{\"event\":{\"description\":\"Event type that announces it.\",\"type\":\"string\"},\"lease\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/LeaseRecord\"},{\"type\":\"null\"}],\"description\":\"Lease whose release ends the hold.\"},\"on\":{\"$ref\":\"#/components/schemas/RetryOn\",\"description\":\"The state change to wait for.\",\"x-ovis-open-enum\":true}},\"required\":[\"on\",\"event\"],\"type\":\"object\"},\"RetryOn\":{\"description\":\"The state change that lets a held or recovering attach succeed on retry.\",\"oneOf\":[{\"const\":\"lease_released\",\"description\":\"The named interact lease is released or revoked (`lease.revoked`).\",\"type\":\"string\"},{\"const\":\"recovered\",\"description\":\"The terminal finishes recovery (`server.recovery`).\",\"type\":\"string\"}]},\"Revision\":{\"description\":\"Revision carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RollbackReason\":{\"description\":\"Why the previous build was selected again.\",\"oneOf\":[{\"const\":\"readiness_failed\",\"description\":\"The selected executable failed its readiness probe.\",\"type\":\"string\"},{\"const\":\"restart_failed\",\"description\":\"The control restart onto the selected build failed.\",\"type\":\"string\"},{\"const\":\"interrupted\",\"description\":\"An activation was interrupted and finished by recovery.\",\"type\":\"string\"},{\"const\":\"requested\",\"description\":\"A caller asked for the rollback.\",\"type\":\"string\"}]},\"RollbackReceipt\":{\"additionalProperties\":false,\"description\":\"The rollback of one activation.\",\"properties\":{\"from\":{\"$ref\":\"#/components/schemas/ActiveBuild\",\"description\":\"Build that was deselected.\"},\"op_id\":{\"$ref\":\"#/components/schemas/OpId\",\"description\":\"Operation that rolled back.\"},\"readiness\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/ReadinessEvidence\"},{\"type\":\"null\"}],\"description\":\"Probe evidence, when a probe ran.\"},\"reason\":{\"$ref\":\"#/components/schemas/RollbackReason\",\"description\":\"Why.\",\"x-ovis-open-enum\":true},\"recorded_ms\":{\"$ref\":\"#/components/schemas/TimestampMs\",\"description\":\"When it was recorded.\"},\"restart\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/ServerTransitionResult\"},{\"type\":\"null\"}],\"description\":\"Control restart onto the restored build, when one ran.\"},\"restored\":{\"$ref\":\"#/components/schemas/ActiveBuild\",\"description\":\"Build selected again.\"}},\"required\":[\"op_id\",\"reason\",\"from\",\"restored\",\"recorded_ms\"],\"type\":\"object\"},\"RpcDiscoverResult\":{\"description\":\"Result of `rpc.discover`: the OpenRPC document of this build.\"},\"RuntimeLifetimeId\":{\"description\":\"Opaque identity string.\",\"type\":\"string\"},\"SchemaCapabilitiesResult\":{\"description\":\"Result of `schema.capabilities`.\",\"properties\":{\"capabilities\":{\"$ref\":\"#/components/schemas/Capabilities\",\"description\":\"Served capabilities.\"},\"generation\":{\"$ref\":\"#/components/schemas/ProtocolGeneration\",\"description\":\"Protocol generation.\"},\"limits\":{\"$ref\":\"#/components/schemas/Limits\",\"description\":\"Advertised limits.\"}},\"required\":[\"generation\",\"capabilities\",\"limits\"],\"type\":\"object\"},\"SchemaErrorsResult\":{\"description\":\"Result of `schema.errors`.\",\"properties\":{\"kinds\":{\"description\":\"Every error kind.\",\"items\":{\"$ref\":\"#/components/schemas/ErrorKindEntry\"},\"type\":\"array\"}},\"required\":[\"kinds\"],\"type\":\"object\"},\"SchemaEventsResult\":{\"description\":\"Result of `schema.events`.\",\"properties\":{\"events\":{\"description\":\"Every event type.\",\"items\":{\"$ref\":\"#/components/schemas/EventTypeEntry\"},\"type\":\"array\"}},\"required\":[\"events\"],\"type\":\"object\"},\"ScreenCursor\":{\"description\":\"Cursor position and visibility.\",\"properties\":{\"col\":{\"description\":\"Zero-based column.\",\"format\":\"uint16\",\"maximum\":65535,\"minimum\":0,\"type\":\"integer\"},\"row\":{\"description\":\"Zero-based row.\",\"format\":\"uint16\",\"maximum\":65535,\"minimum\":0,\"type\":\"integer\"},\"visible\":{\"description\":\"Whether the cursor is visible.\",\"type\":\"boolean\"}},\"required\":[\"row\",\"col\",\"visible\"],\"type\":\"object\"},\"SearchMatch\":{\"description\":\"One search match.\",\"properties\":{\"col\":{\"description\":\"Column of the first matched cell.\",\"format\":\"uint16\",\"maximum\":65535,\"minimum\":0,\"type\":\"integer\"},\"len\":{\"description\":\"Matched length in cells.\",\"format\":\"uint16\",\"maximum\":65535,\"minimum\":0,\"type\":\"integer\"},\"line\":{\"$ref\":\"#/components/schemas/LineNumber\",\"description\":\"History line of the mat
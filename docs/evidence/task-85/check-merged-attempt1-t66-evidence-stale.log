ted\",\"description\":\"A Kitty `a=d` command named it.\",\"type\":\"string\"},{\"const\":\"replaced\",\"description\":\"A Kitty transmission reused its image id.\",\"type\":\"string\"},{\"const\":\"reset\",\"description\":\"The terminal was reset (RIS).\",\"type\":\"string\"},{\"const\":\"limit\",\"description\":\"The terminal retained more images than it tracks; the oldest went first.\",\"type\":\"string\"},{\"const\":\"store_full\",\"description\":\"Retaining a newer sequence exceeded `graphics_terminal_store_max_bytes`.\",\"type\":\"string\"},{\"const\":\"expired\",\"description\":\"It is no longer shown; the specific cause was not retained.\",\"type\":\"string\"}]},\"GraphicsReleased\":{\"additionalProperties\":false,\"description\":\"One released graphics sequence.\",\"properties\":{\"output_offset\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Raw output offset where the sequence began.\"},\"reason\":{\"$ref\":\"#/components/schemas/GraphicsReleaseReason\",\"description\":\"Why it left.\",\"x-ovis-open-enum\":true}},\"required\":[\"output_offset\",\"reason\"],\"type\":\"object\"},\"GraphicsReplayedData\":{\"additionalProperties\":false,\"description\":\"Data of a `graphics_replayed` record: the paint before it re-sent `replayed`.\",\"properties\":{\"released\":{\"description\":\"The most recently released sequences, at most 64, in receipt order (by\\n`output_offset`), however output was split into reads.\",\"items\":{\"$ref\":\"#/components/schemas/GraphicsReleased\"},\"type\":\"array\"},\"replayed\":{\"description\":\"Raw output offsets of the re-sent sequences, in the order the paint sent them.\",\"items\":{\"$ref\":\"#/components/schemas/ByteOffset\"},\"type\":\"array\"}},\"required\":[\"replayed\",\"released\"],\"type\":\"object\"},\"Heartbeat\":{\"description\":\"Idle heartbeat of one subscription.\",\"properties\":{\"boot_id\":{\"$ref\":\"#/components/schemas/ServerBootId\",\"description\":\"Control-server boot.\"},\"lifetime\":{\"$re
ase\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/LeaseId\"},{\"type\":\"null\"}],\"description\":\"Geometry lease that requested the change, for `geometry.changed`.\"},\"previous\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/Geometry\"},{\"type\":\"null\"}],\"description\":\"Grid before the change, for `geometry.changed`.\"},\"revision\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/Revision\"},{\"type\":\"null\"}],\"description\":\"Screen revision at the new grid, for the checkpoint and input readiness.\"},\"terminal_id\":{\"$ref\":\"#/components/schemas/TerminalId\",\"description\":\"Terminal whose grid changed.\"}},\"required\":[\"terminal_id\",\"epoch\",\"geometry\"],\"type\":\"object\"},\"GrantEpoch\":{\"$ref\":\"#/components/schemas/DecimalCounter\",\"description\":\"Holder GrantEpoch as a canonical decimal string.\"},\"GraphicsDropReason\":{\"description\":\"Why a whole graphics sequence was dropped.\",\"oneOf\":[{\"const\":\"too_large\",\"description\":\"The sequence exceeded `graphics_sequence_max_bytes`.\",\"type\":\"string\"}]},\"GraphicsDroppedData\":{\"additionalProperties\":false,\"description\":\"Data of `graphics.dropped`: one sequence was dropped whole, never delivered in part.\",\"properties\":{\"limit_bytes\":{\"$ref\":\"#/components/schemas/ByteCount\",\"description\":\"The cap in force.\"},\"output_offset\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Raw output offset where the sequence began.\"},\"protocol\":{\"$ref\":\"#/components/schemas/GraphicsProtocol\",\"description\":\"Protocol of the dropped sequence.\",\"x-ovis-open-enum\":true},\"reason\":{\"$ref\":\"#/components/schemas/GraphicsDropReason\",\"description\":\"Why it was dropped.\",\"x-ovis-open-enum\":true},\"sequence_bytes\":{\"$ref\":\"#/components/schemas/ByteCount\",\"description\":\"Raw bytes seen before the drop; at least `limit_bytes` plus one.\"}},\"required\":[\"protocol\",\"reason\",\"output_offset\",\"sequence_bytes\",\"limit_bytes\"],\"type\":\"objec
 operation identity.\"},\"remove\":{\"description\":\"Label keys to remove.\",\"items\":{\"type\":\"string\"},\"type\":[\"array\",\"null\"]},\"set\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Labels to set.\",\"type\":[\"object\",\"null\"]},\"target\":{\"$ref\":\"#/components/schemas/Target\",\"description\":\"Terminal to change.\"}},\"required\":[\"op_id\",\"target\"],\"type\":\"object\"},\"TerminalListParams\":{\"additionalProperties\":false,\"description\":\"Parameters of `terminal.list`.\",\"properties\":{\"children_of\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/TerminalId\"},{\"type\":\"null\"}],\"description\":\"Only children of this terminal.\"},\"labels\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Only terminals carrying all of these labels.\",\"type\":[\"object\",\"null\"]},\"machine\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/MachineRef\"},{\"type\":\"null\"}],\"description\":\"Only terminals on this machine.\"},\"page\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/PageRequest\"},{\"type\":\"null\"}],\"description\":\"Page request.\"},\"states\":{\"description\":\"Only terminals in these states.\",\"items\":{\"$ref\":\"#/components/schemas/TerminalState\"},\"type\":[\"array\",\"null\"]}},\"type\":\"object\"},\"TerminalListResult\":{\"description\":\"Result of `terminal.list`.\",\"properties\":{\"page\":{\"$ref\":\"#/components/schemas/PageInfo\",\"description\":\"Paging facts.\"},\"retention_floor\":{\"$ref\":\"#/components/schemas/EventSeq\",\"description\":\"Oldest finished terminal still retained.\"},\"terminals\":{\"description\":\"Terminals in this page.\",\"items\":{\"$ref\":\"#/components/schemas/TerminalRecord\"},\"type\":\"array\"}},\"required\":[\"terminals\",\"page\",\"retention_floor\"],\"type\":\"object\"},\"TerminalMode\":{\"description\":\"A terminal mode the VT engine tracks.\",\"oneOf\":[{\"const\":\"bracketed_paste\",\"description\":\"Bracketed paste.\",\"type\":\"string\"},{\"const\":\"
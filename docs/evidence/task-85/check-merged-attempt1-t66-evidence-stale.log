ence, for `graphics_dropped`.\"},\"graphics_evicted\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/GraphicsEvictedData\"},{\"type\":\"null\"}],\"description\":\"What the store evicted, for `graphics_evicted`.\"},\"graphics_replayed\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/GraphicsReplayedData\"},{\"type\":\"null\"}],\"description\":\"What the paint re-sent and what was released, for `graphics_replayed`.\"},\"kind\":{\"$ref\":\"#/components/schemas/ControlKind\",\"description\":\"Record kind.\",\"x-ovis-open-enum\":true},\"skipped\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/SkippedOutput\"},{\"type\":\"null\"}],\"description\":\"Skipped raw output, for `gap`.\"},\"stream_id\":{\"$ref\":\"#/components/schemas/StreamId\",\"description\":\"Stream.\"},\"stream_offset\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Filtered stream offset the record applies at.\"}},\"required\":[\"stream_id\",\"kind\",\"stream_offset\"],\"type\":\"object\"},\"AttachCreditParams\":{\"additionalProperties\":false,\"description\":\"Parameters of `attach.credit` for plain-mode streams.\",\"properties\":{\"acknowledged\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Cumulative filtered-stream offset the client has consumed.\"},\"stream_id\":{\"$ref\":\"#/components/schemas/StreamId\",\"description\":\"Stream.\"}},\"required\":[\"stream_id\",\"acknowledged\"],\"type\":\"object\"},\"AttachData\":{\"description\":\"Params of the `attach.data` notification: terminal bytes only.\",\"properties\":{\"data_b64\":{\"description\":\"Base64 terminal bytes, at most one stream chunk decoded.\",\"type\":\"string\"},\"offset\":{\"$ref\":\"#/components/schemas/ByteOffset\",\"description\":\"Filtered stream offset of the first byte.\"},\"stream_id\":{\"$ref\":\"#/components/schemas/StreamId\",\"description\":\"Stream.\"}},\"required\":[\"stream_id\",\"offset\",\"data_b64\"],\"type\":\"object\"},\"AttachLeaseParams\":{\"additionalProperties\":false,\"description\":\"P
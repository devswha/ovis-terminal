e\":\"null\"}],\"description\":\"Agent of the terminal's current program; null for a plain program.\"},\"session\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/SessionRef\"},{\"type\":\"null\"}],\"description\":\"Session that agent declared, when it declared one.\"},\"source\":{\"$ref\":\"#/components/schemas/ConversationSource\",\"description\":\"The source that was read.\",\"x-ovis-open-enum\":true}},\"required\":[\"source\"],\"type\":\"object\"},\"QueuePosition\":{\"description\":\"QueuePosition carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RacedWrite\":{\"description\":\"One write raced by a withdrawal: its admission receipt and its fate.\",\"properties\":{\"admitted_bytes\":{\"$ref\":\"#/components/schemas/ByteCount\",\"description\":\"Bytes admitted.\"},\"op_id\":{\"$ref\":\"#/components/schemas/OpId\",\"description\":\"Operation that admitted the write.\"},\"queued_seq\":{\"$ref\":\"#/components/schemas/EventSeq\",\"description\":\"Its position in the terminal's input sequence.\"},\"race\":{\"$ref\":\"#/components/schemas/CommitRace\",\"description\":\"What happened to them.\"}},\"required\":[\"op_id\",\"queued_seq\",\"admitted_bytes\",\"race\"],\"type\":\"object\"},\"ReadinessContract\":{\"description\":\"How a launched program proves it can take its first message.\\n\\nOnly a declaration by the program counts; output silence is never readiness.\",\"oneOf\":[{\"additionalProperties\":false,\"description\":\"The program declares one of `states` through OSC 7501 or `status.report`.\",\"properties\":{\"by\":{\"const\":\"declared\",\"type\":\"string\"},\"states\":{\"description\":\"Declared states that release the first message.\",\"items\":{\"$ref\":\"#/components/schemas/AgentState\",\"x-ovis-open-enum\":true},\"type\":\"array\"}},\"required\":[\"by\",\"states\"],\"type\":\"object\"}]},\"ReadinessEvidence\":{\"additionalProperties\":false,\"description\":\"Probe outcome and the bounded output that supports it.\",\"properties\":{\"exit_code\":{\"description\":\"Exit status, when the probe exited with one; absent for a signal or no exit.\",\"format\":\"int32\",\"type\":[\"integer\",\"null\"]},\"outcome\":{\"$ref\":\"#/components/schemas/ProbeOutcome\",\"description\":\"How the probe ended.\",\"x-ovis-open-enum\":true},\"stdout\":{\"description\":\"Leading standard output, lossily decoded and bounded.\",\"type\":\"string\"}},\"required\":[\"outcome\",\"stdout\"],\"type\":\"object\"},\"RecordBlock\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/ContentBlock\",\"description\":\"A block of the typed record contract; every reported record carries only these.\"},{\"description\":\"A transcript block outside the typed contract, unchanged.\"}],\"description\":\"A record block: typed, or provider content a transcript carried as it was.\"},\"RecordCount\":{\"description\":\"RecordCount carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RecordId\":{\"description\":\"Opaque identity string.\",\"type\":\"string\"},\"RecordInput\":{\"additionalProperties\":false,\"description\":\"One record as the owning process reports it.\",\"properties\":{\"at_ms\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/TimestampMs\"},{\"type\":\"null\"}],\"description\":\"Time the provider recorded for the record, when it recorded one.\"},\"blocks\":{\"description\":\"Content blocks in provider order, text and tool results side by side.\",\"items\":{\"$ref\":\"#/components/schemas/ContentBlock\"},\"type\":\"array\"},\"phase\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/MessagePhase\"},{\"type\":\"null\"}],\"description\":\"Phase of assistant text, when the provider recorded one.\"},\"record_id\":{\"$ref\":\"#/components/schemas/RecordId\",\"description\":\"Record identity, unique within the agent's records.\"},\"role\":{\"$ref\":\"#/components/schemas/RecordRole\",\"description\":\"Who the record speaks for.\"}},\"required\":[\"record_id\",\"role\",\"blocks\"],\"type\":\"object\"},\"RecordPosition\":{\"description\":\"RecordPosition carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RecordRole\":{\"description\":\"Who a record speaks for.\",\"oneOf\":[{\"const\":\"user\",\"description\":\"The person driving the agent; text and tool results.\",\"type\":\"string\"},{\"const\":\"assistant\",\"description\":\"The agent; text and tool calls.\",\"type\":\"string\"},{\"const\":\"tool\",\"description\":\"A tool's own record; tool results only.\",\"type\":\"string\"}]},\"RecordVersion\":{\"description\":\"RecordVersion carried as a canonical decimal string.\",\"pattern\":\"^(0|[1-9][0-9]{0,19})$\",\"type\":\"string\"},\"RecordsAppended\":{\"description\":\"Payload of `agent.records_appended` and result of `agent.append_records`.\\n\\nIt names the appended records by identity, count and digest; their bodies are read\\nwith `agent.records`, so the receipt stays small whatever the records hold.\",\"properties\":{\"agent_id\":{\"$ref\":\"#/components/schemas/AgentId\",\"description\":\"Agent whose records grew.\"},\"digest\":{\"$ref\":\"#/components/schemas/RecordsDigest\",\"description\":\"`sha256:` over the stored encodings of the appended records, concatenated in order;\\nthe wire reply of `agent.records` is a different serialization.\"},\"first_position\":{\"$ref\":\"#/components/schemas/RecordPosition\",\"description\":\"Position of the first appended record.\"},\"history_id\":{\"$ref\":\"#/components/schemas/HistoryId\",\"description\":\"Identity of the agent's record history.\"},\"process_incarnation\":{\"$ref\":\"#/components/schemas/Incarnation\",\"description\":\"Program incarnation that reported them.\"},\"record_ids\":{\"description\":\"Identities of the appended records, in order.\",\"items\":{\"$ref\":\"#/components/schemas/RecordId\"},\"type\":\"array\"},\"revision\":{\"$ref\":\"#/components/schemas/HistoryRevision\",\"description\":\"History revision after the append.\"},\"total_bytes\":{\"$ref\":\"#/components/schemas/ByteCount\",\"description\":\"Stored bytes of the agent's records after the append.\"},\"total_records\":{\"$ref\":\"#/components/schemas/RecordCount\",\"description\":\"Records the agent holds after the append.\"},\"turns\":{\"description\":\"Turns the appended records or metadata belong to.\",\"items\":{\"$ref\":\"#/components/schemas/ConversationTurn\"},\"type\":\"array\"}},\"required\":[\"agent_id\",\"process_incarnation\",\"history_id\",\"revision\",\"record_ids\",\"first_position\",\"total_records\",\"total_bytes\",\"digest\",\"turns\"],\"type\":\"object\"},\"RecordsDigest\":{\"description\":\"`sha256:` and the lowercase hex SHA-256 of the appended records' stored encoding.\",\"type\":\"string\"},\"RecoveryEvidence\":{\"description\":\"One recorded recovery fact; reads never clear it.\",\"properties\":{\"gaps\":{\"description\":\"Sequence ranges that could not be recovered.\",\"items\":{\"$ref\":\"#/components/schemas/EventSeq\"},\"type\":\"array\"},\"recorded_ms\":{\"$ref\":\"#/components/schemas/TimestampMs\",\"description\":\"Time the evidence was recorded.\"},\"restored\":{\"description\":\"Restored or relaunched terminal incarnations.\",\"items\":{\"$ref\":\"#/components/schemas/Incarnation\"},\"type\":\"array\"},\"server_boot_id\":{\"$ref\":\"#/components/schemas/ServerBootId\",\"description\":\"Boot the evidence belongs to.\"}},\"required\":[\"server_boot_id\",\"restored\",\"gaps\",\"recorded_ms\"],\"type\":\"object\"},\"RecoveryPhase\":{\"description\":\"Summary of what recovery found; reading it never clears it.\",\"oneOf\":[{\"const\":\"clean\",\"description\":\"No recovery and no incident was ever recorded.\",\"type\":\"string\"},{\"const\":\"recovered\",\"description\":\"This lifetime recovered or recorded incidents, and every terminal is settled.\",\"type\":\"string\"},{\"const\":\"degraded\",\"description\":\"Damaged material was recorded or a terminal's survival is still unknown.\",\"t
ckpoint\",\"description\":\"A checkpoint paint begins at `stream_offset`.\",\"type\":\"string\"},{\"const\":\"gap\",\"description\":\"Bytes were skipped; a checkpoint follows.\",\"type\":\"string\"},{\"const\":\"input_ready\",\"description\":\"The interact stream is ready for input.\",\"type\":\"string\"},{\"const\":\"input_revoked\",\"description\":\"Input readiness was revoked.\",\"type\":\"string\"},{\"const\":\"close\",\"description\":\"The stream closed; no record or byte follows.\",\"type\":\"string\"},{\"const\":\"graphics_dropped\",\"description\":\"A whole graphics sequence over its cap was dropped where this record stands.\",\"type\":\"string\"},{\"const\":\"graphics_evicted\",\"description\":\"Retaining a graphics sequence evicted the terminal's oldest retained ones.\",\"type\":\"string\"},{\"const\":\"graphics_replayed\",\"description\":\"The checkpoint paint re-sent the retained graphics still shown.\",\"type\":\"string\"}]},\"ConversationCursor\":{\"additionalProperties\":false,\"description\":\"A page position bound to one history identity, revision and chain.\",\"properties\":{\"head\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/RecordId\"},{\"type\":\"null\"}],\"description\":\"Last record of the chain being read; absent for the active chain.\"},\"history_id\":{\"$ref\":\"#/components/schemas/HistoryId\",\"description\":\"History the position belongs to.\"},\"position\":{\"$ref\":\"#/components/schemas/RecordPosition\",\"description\":\"Records of the chain already returned.\"},\"revision\":{\"$ref\":\"#/components/schemas/HistoryRevision\",\"description\":\"Revision the position was issued at.\"}},\"required\":[\"history_id\",\"revision\",\"position\"],\"type\":\"object\"},\"ConversationRecord\":{\"description\":\"One conversation record with provenance.\",\"properties\":{\"at_ms\":{\"anyOf\":[{\"$ref\":\"#/components/schemas/TimestampMs\"},{\"type\":\"null\"}],\"description\":\"Time the provider recorded for the record.\"},\"blocks\":{\"descripti
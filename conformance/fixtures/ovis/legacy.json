{
  "format": "ovis-legacy-map/1",
  "methods": {
    "pane.split": {
      "method": "layout.edit",
      "into": "edit",
      "constant": {
        "op": "split_pane"
      },
      "fields": {
        "pane_id": {
          "to": "pane_id"
        },
        "direction": {
          "to": "axis",
          "values": {
            "right": "horizontal",
            "left": "horizontal",
            "down": "vertical",
            "up": "vertical"
          }
        }
      }
    }
  }
}

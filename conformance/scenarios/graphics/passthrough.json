      "case": "happy",
      "summary": "Real ovis-terminal serve runs a shell as t1; an interact viewer attaches and types the go key on its own lease, then the program writes a 3-chunk Kitty f=100 PNG (m=1, m=1, m=0) and a sixel; the viewer's DATA bytes are contiguous and contain both sequences byte-identical (SHA-256 of the found window equals that of the written bytes), with only the checkpoint as a control record.",
      "steps": [
        {
          "serve": {
            "fixture": "assembled"
          }
        },
        {
          "connect": {
            "conn": "control",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "control",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/methods": {
                "$contains": [
                  "attach.open",
                  "input.raw",
                  "terminal.run",
                  "terminal.screen"
                ]
              }
            }
          }
        },
        {

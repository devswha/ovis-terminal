            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "run",
                "method": "terminal.run",
                "params": {
                  "op_id": "$op:run",
                  "program": {
                    "argv": [
                      "/bin/sh",
                      "-c",
                      "read go; printf '\\033_Ga=T,f=100,i=7,m=1;iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB\\033\\\\\\033_Gm=1;CAYAAAAfFcSJAAAADUlEQVR42mNk+M9Q\\033\\\\\\033_Gm=0;DwADhgGAWjR9awAAAABJRU5ErkJggg==\\033\\\\'; printf '\\033P0;1;0q\"1;1;6;6#0;2;100;0;0#0~~~~~~-\\033\\\\'; printf 'image-done'; read done"
                    ]
                  },
                  "geometry": {
                    "cols": 80,
                    "rows": 24
                  },
                  "cwd": "/tmp",
                  "env": {
                    "PATH": "/usr/bin:/bin",
                    "TERM": "xterm"
                  },
                  "name": "graphics",
                  "labels": null,
                  "parent": null,
                  "child_policy": null,
                  "keep": null,
                  "first_message": null,
                  "machine": null
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {

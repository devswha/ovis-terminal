                "id": "go",
                "method": "input.raw",
                "params": {
                  "op_id": "$op:go",
                  "target": {
                    "address": "t1"
                  },
                  "expect": null,
                  "data_b64": "DQ==",
                  "lease_id": "$value:lease_viewer"

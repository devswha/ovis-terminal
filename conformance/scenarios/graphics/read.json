            },
            "controls": [
              "checkpoint",
              "input_ready"
            ]
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "with-images",
                "method": "terminal.screen",
                "params": {
                  "target": {
                    "address": "t1"
                  },
                  "format": "text",
                  "include_images": true

{
  "format": "ovis-conformance/1",
  "scenario": "graphics/read",
  "title": "Screen reads report each stored image as a placeholder at its cells, never its payload",
  "todo": 85,
  "closes": [
    "GAP-153"
  ],
  "delivers": [
    "IDEAL-120"
  ],
  "platforms": [
    "linux",
    "macos"
  ],
  "cases": [
    {
      "case": "happy",
      "summary": "Real ovis-terminal serve runs a shell as t1; an interact viewer types go and the program prints ab then a 3-chunk Kitty f=100 PNG declaring c=4,r=2 (raw offset 4, 145 bytes) and three line feeds before images-done; the viewer receives the sequence byte-identical. terminal.screen with include_images true returns lines unchanged (row 1 is ab, the covered cells stay blank text) plus exactly one placeholder {image_id 4, format kitty, row 1, col 2, rows 2, cols 4, bytes 145} whose id is the image store key; the same read without include_images carries no images field.",
      "steps": [
        {
          "serve": {
            "fixture": "assembled"
          }
        },
        {
          "connect": {
            "conn": "control",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "control",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/methods": {
                "$contains": [
                  "attach.open",
                  "input.raw",
                  "terminal.run",
                  "terminal.screen"
                ]
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "run",
                "method": "terminal.run",
                "params": {
                  "op_id": "$op:run",
                  "program": {
                    "argv": [
                      "/bin/sh",
                      "-c",
                      "read go; printf 'ab\\033_Ga=T,f=100,i=7,c=4,r=2,m=1;iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB\\033\\\\\\033_Gm=1;CAYAAAAfFcSJAAAADUlEQVR42mNk+M9Q\\033\\\\\\033_Gm=0;DwADhgGAWjR9awAAAABJRU5ErkJggg==\\033\\\\'; printf '\\r\\n\\r\\n\\r\\nimages-done'; read done"
                    ]
                  },
                  "geometry": {
                    "cols": 80,
                    "rows": 24
                  },
                  "cwd": "/tmp",
                  "env": {
                    "PATH": "/usr/bin:/bin",
                    "TERM": "xterm"
                  },
                  "name": "read",
                  "labels": null,
                  "parent": null,
                  "child_policy": null,
                  "keep": null,
                  "first_message": null,
                  "machine": null
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "run": {
                "/error": {
                  "$present": false
                },
                "/result/spawn": "spawned",
                "/result/terminal/address": "t1"
              }
            }
          }
        },

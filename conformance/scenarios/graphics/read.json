          "replies": {
            "conn": "control",
            "expect": {
              "with-images": {
                "/error": {
                  "$present": false
                },
                "/result/images": [
                  {
                    "image_id": "4",
                    "format": "kitty",
                    "row": 1,
                    "col": 2,
                    "rows": 2,
                    "cols": 4,
                    "bytes": "145"
                  }
                ],
                "/result/lines/0": "",
                "/result/lines/1": "ab",
                "/result/lines/2": "",
                "/result/lines/4": "images-done"
              },
              "plain": {
                "/error": {
                  "$present": false
                },
                "/result/images": {
                  "$present": false
                },
                "/result/lines/1": "ab"
              }
            }
          }
        },
        {
          "hangup": {
            "conn": "control"
          }
        },
        {
          "closed": {
            "conn": "control"
          }
        },
        {
          "stop": {
            "expect": {
              "/panicked": "0"
            }
          }
        }
      ]
    },

        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "before",
                "method": "update.query",
                "params": {}
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "before": {
                "/result/active_version": "1.0.0",
                "/result/active/binary_sha256": {
                  "$capture": "original"
                },
                "/result/live_incarnations": {
                  "$capture": "live"
                },
                "/result/previous": null,
                "/result/pending": null,
                "/result/updates": []
              }
            }
          }
        },
        {
          "inject": {
            "conn": "bridge",
            "base": {
              "op_id": "$op:inject",
              "version": "2.0.0"
            },
            "planned": [
              {
                "request": {
                  "method": "update.stage",

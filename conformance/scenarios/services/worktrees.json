    {
      "case": "happy",
      "summary": "A program in the isolated root creates a Git repository and registers it in <state>/worktrees.json; after a planned restart the successor lists the primary checkout, creates one from its explicit id, opens it as a layout workspace, refuses removal without group scope (scope_required) and with group scope closes exactly that workspace and removes the checkout.",
      "steps": [
        {
          "serve": {
            "fixture": "assembled"
          }
        },
        {
          "connect": {
            "conn": "control",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "control",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/methods": {
                "$contains": [
                  "worktree.list",
                  "worktree.create",
                  "worktree.open",
                  "worktree.remove",
                  "server.restart"
                ]
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "run",
                "method": "terminal.run",
                "params": {
                  "op_id": "$op:run",
                  "program": {
                    "argv": [
                      "/bin/sh",
                      "-c",
                      "set -e; r=$(pwd); mkdir -p wt/repo wt/checkouts; cd wt/repo; git init -q -b main; echo kept > README; git add README; git -c user.name=t -c user.email=t@e commit -qm init; cd \"$r\"; printf '{\"root\":\"%s/wt\",\"repositories\":[{\"id\":\"repo:main\",\"path\":\"%s/wt/repo\",\"checkouts\":\"%s/wt/checkouts\"}]}' \"$r\" \"$r\" \"$r\" > srv/state/worktrees.json; echo REGISTERED-$((1+1))"
                    ]
                  },
                  "geometry": {
                    "cols": 80,
                    "rows": 24
                  },
                  "cwd": null,
                  "env": {
                    "PATH": "/usr/bin:/bin",
                    "PS1": "$ ",
                    "TERM": "xterm"
                  },
                  "name": "register",
                  "labels": null,
                  "parent": null,
                  "child_policy": null,
                  "keep": null,
                  "first_message": null,
                  "machine": null
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "run": {
                "/error": {
                  "$present": false
                },
                "/result/spawn": "spawned"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "written",
                "method": "terminal.wait_output",
                "params": {
                  "target": {
                    "address": "t1"
                  },
                  "cursor": {
                    "offset": "0"
                  },
                  "pattern": {
                    "text": "REGISTERED-2"
                  },
                  "timeout_ms": "20000"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "written": {
                "/error": {
                  "$present": false
                },
                "/result/outcome": "matched"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "restart",
                "method": "server.restart",
                "params": {
                  "op_id": "$op:restart"
                }
              }
            ]
          }
        },
        {
          "replies": {

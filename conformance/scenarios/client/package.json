{
  "format": "ovis-conformance/1",
  "scenario": "client/package",
  "title": "The packed Bun client's wire contract: one persistent connection, exact u64 values, additive output values and typed refusals that are never resent",
  "todo": 63,
  "closes": [
    "GAP-004",
    "GAP-005",
    "GAP-018",
    "GAP-019",
    "GAP-023",
    "GAP-026",

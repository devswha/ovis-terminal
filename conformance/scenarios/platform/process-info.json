                "/result/roles/launcher/state": "known",
                "/result/roles/launcher/value/argv/value/0": "/bin/sh",
                "/result/roles/launcher/value/start_token": {
                  "$present": true
                },
                "/result/roles/foreground/state": "known",
                "/result/roles/foreground/value/0/argv/value": [
                  "/bin/sh",
                  "-c",
                  "printf FG_READY; read gate"
                ],
                "/result/roles/foreground/value/0/start_token": {
                  "$present": true
                },
                "/result/roles/foreground/value/1": {
                  "$present": false
                },
                "/result/roles/background/state": "known",

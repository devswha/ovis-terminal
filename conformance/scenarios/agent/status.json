          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "agent",
                "method": "agent.get",
                "params": {
                  "target": {
                    "name": "agent"
                  }
                }
              },
              {
                "jsonrpc": "2.0",
                "id": "shell",
                "method": "agent.get",
                "params": {
                  "target": {
                    "name": "shell"
                  }
                }
              },
              {
                "jsonrpc": "2.0",
                "id": "shell-status",
                "method": "status.get",
                "params": {
                  "target": {
                    "name": "shell"
                  }
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "agent": {
                "/result/agent/label": "custom-agent"
              },
              "shell": {
                "/result/agent": null,
                "/error": {
                  "$present": false
                }
              },
              "shell-status": {
                "/result/status/reported": false,
                "/result/status/root": null,
                "/result/status/process_incarnation": "1"
              }
            }
          }
        },
        {
          "hangup": {
            "conn": "bridge"
          }
        },
        {
          "closed": {
            "conn": "bridge"
          }
        },
        {
          "stop": {
            "expect": {
              "/accepted": "1",
              "/panicked": "0"
            }
          }
        }
      ]
    },

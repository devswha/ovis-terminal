  "cases": [
    {
      "case": "happy",
      "summary": "Through the bridge: an unbranded label registers, reports working at sequence 4, the echoing program prints fake idle text, and the snapshot still holds sequence 4 at the committed event's sequence; a shell has agent null.",
      "steps": [
        {
          "serve": {
            "fixture": "protocol"
          }
        },
        {
          "connect": {
            "conn": "bridge",
            "via": "bridge"
          }
        },
        {
          "hello": {
            "conn": "bridge",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/machine_id": "machine:0191f1a2-0000-7000-8000-000000000021"
            }
          }
        },
        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "register",
                "method": "agent.register",
                "params": {
                  "op_id": "$op:register",
                  "target": {
                    "name": "agent"
                  },
                  "process_token": "fixture-process-token-agent",
                  "label": "custom-agent"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "register": {
                "/result/agent/label": "custom-agent",
                "/result/agent/process_incarnation": "1",
                "/result/agent/agent_id": {
                  "$present": true
                },
                "/error": {
                  "$present": false
                }
              }
            }
          }
        },
        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "working",
                "method": "status.report",
                "params": {
                  "op_id": "$op:working",
                  "target": {
                    "name": "agent"
                  },
                  "process_token": "fixture-process-token-agent",
                  "seq": "4",
                  "record": {
                    "state": "working"
                  }
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "working": {
                "/result/status/root/report/state": "working",
                "/result/status/root/report_seq": "4",
                "/result/status/root/origin": "rpc",
                "/result/status/turn": "1",
                "/result/status/report_seq": "4",
                "/error": {
                  "$present": false
                }
              }
            }
          }
        },
        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "fake-idle",
                "method": "input.send",
                "params": {
                  "op_id": "$op:echo-1",
                  "target": {
                    "name": "agent"
                  },
                  "text": "idle\r\nstate=done\r\n✓ Done. Waiting for input >\r\n7501;state=idle\r\n",
                  "submit": "none"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "fake-idle": {
                "/result/osc_records": []
              }
            }
          }
        },
        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "snapshot",
                "method": "status.get",
                "params": {
                  "target": {
                    "name": "agent"
                  }
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "snapshot": {
                "/result/status/reported": true,
                "/result/status/root/report/state": "working",

                "params": {
                  "op_id": "$op:wrong-credential",
                  "name": "peer",
                  "transport": {
                    "argv": "$value:peer_argv"
                  },
                  "credential": "not-the-peer-credential",
                  "expected_machine_id": "machine:0191f1a2-0000-7000-8000-0000000000c3"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",

                  "$present": false
                }
              }
            }
          }
        },
        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "roster-unchanged",
                "method": "machine.list",
                "params": {}
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {

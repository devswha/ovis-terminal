                "jsonrpc": "2.0",
                "id": "run-parent",
                "method": "terminal.run",
                "params": {
                  "op_id": "$op:run-parent",
                  "program": {
                    "argv": [
                      "agent"
                    ]
                  },
                  "geometry": {

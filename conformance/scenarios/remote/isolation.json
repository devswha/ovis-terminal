            "conn": "bridge",
            "expect": {
              "roster-before": {
                "/error": {
                  "$present": false
                },
                "/result/machines/0/machine_id": "machine:0191f1a2-0000-7000-8000-0000000000a1",
                "/result/machines/0/state": "connected",
                "/result/machines/1/machine_id": "machine:0191f1a2-0000-7000-8000-0000000000b2",

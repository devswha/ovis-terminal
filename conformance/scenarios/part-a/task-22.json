{
  "scenario": "part-a/task-22",
  "todo": 22,
  "title": "Independent subscriptions, replay and recoverable loss",
  "closes": [
    "GAP-021",
    "GAP-022",
    "GAP-023",
    "GAP-026",
    "GAP-027",
    "GAP-028",
    "GAP-029",
    "GAP-030",
    "GAP-031"
  ],
  "delivers": [
    "IDEAL-015",
    "IDEAL-018",
    "IDEAL-019",
    "IDEAL-020",
    "IDEAL-021",
    "IDEAL-022",
    "IDEAL-023"
  ],
  "excludes": [
    "EXCL-015"
  ],
  "platforms": [
    "linux",
    "macos"
  ],
  "verification": {
    "status": "declared_until_routed",
    "core_tests": "cargo nextest run -p ovis-terminal-core --test subscriptions",
    "blocking_todo": 31,
    "requires_actual_cli_socket_transcript": true
  },
  "cases": [
    {
      "case": "happy",
      "steps": [
        {
          "rpc": "events.subscribe",
          "params": {
            "filter": {},
            "snapshot": true
          },
          "capture": [
            "subscription_id",
            "snapshot_seq"
          ],
          "as": "all"
        },
        {
          "rpc": "events.subscribe",
          "params": {
            "filter": {
              "terminals": [
                "$terminal_1"
              ]
            },
            "snapshot": true
          },
          "capture": [
            "subscription_id"
          ],
          "as": "filtered"
        },
        {
          "commit": [
            "terminal_2 changes",
            "terminal_1 changes"
          ]
        },
        {
          "as": "filtered",
          "rpc": "events.update",
          "params": {
            "subscription_id": "$filtered.subscription_id",
            "filter": {
              "terminals": [
                "$terminal_2"
              ]
            }
          },
          "assert": {
            "effective_seq": "$filtered.scan_seq+1",
            "all_stream_still_delivers": true
          }
        },
        {
          "as": "all",
          "rpc": "events.subscribe",
          "params": {
            "filter": {},
            "cursor": {
              "runtime_lifetime": "$runtime_lifetime",
              "seq": "$all.snapshot_seq"
            },
            "snapshot": false
          },
          "assert": {
            "missed": null,
            "replay_equals_live_events": true,
            "snapshot_plus_events_equals_fresh_snapshot": true,
            "filtered_scan_seq_covers_nonmatching_gap": true
          }
        }
      ]
    },
    {
      "case": "failure",
      "steps": [
        {
          "inject": {
            "fixture": "withhold_reads",
            "subscription": "$withheld.subscription_id",
            "past": "queue_events"
          },
          "assert": {
            "healthy_subscription_delivers_every_event": true,
            "loss_marker.cause": "queue_overflow"
          }
        },
        {
          "inject": {
            "fixture": "drop_connection_before_final_error"
          }
        },
        {
          "as": "withheld",
          "rpc": "events.subscribe",
          "params": {
            "filter": {},
            "cursor": {
              "runtime_lifetime": "$runtime_lifetime",
              "seq": "$withheld.snapshot_seq"
            },
            "snapshot": false
          },
          "assert": {
            "missed": "cursor_expired",
            "snapshot_present": true,
            "durable_loss_marker_committed": true
          }
        },
        {
          "rpc": "events.subscribe",
          "params": {
            "filter": {},
            "cursor": {
              "runtime_lifetime": "$foreign_runtime_lifetime",
              "seq": "1"
            },
            "snapshot": false
          },
          "assert": {
            "missed": "lifetime_mismatch",
            "snapshot_present": true
          }
        }
      ]
    }
  ]
}

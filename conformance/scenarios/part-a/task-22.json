{
  "format": "ovis-conformance/1",
  "scenario": "part-a/task-22",
  "title": "Independent subscriptions, replay and recoverable loss",
  "todo": 22,
  "closes": [
    "GAP-021",
    "GAP-022",
    "GAP-023",
    "GAP-026",
    "GAP-027",
    "GAP-028",
    "GAP-029",
    "GAP-030",
    "GAP-031"
  ],
  "delivers": [
    "IDEAL-015",
    "IDEAL-018",
    "IDEAL-019",
    "IDEAL-020",
    "IDEAL-021",
    "IDEAL-022",
    "IDEAL-023"
  ],
  "excludes": [
    "EXCL-015"
  ],
  "platforms": [
    "linux",
    "macos"
  ],
  "cases": [
    {
      "case": "happy",
      "summary": "A subscription filtered to doc.changed receives the committed doc.set as an event notification on its own connection; update replaces the filter and unsubscribe reports where delivery stopped.",
      "steps": [
        {
          "serve": {
            "fixture": "assembled"
          }
        },
        {
          "connect": {
            "conn": "control",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "control",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/methods": {
                "$contains": [
                  "events.subscribe",
                  "events.update",
                  "events.unsubscribe"
                ]
              }
            }
          }
        },
        {
          "connect": {
            "conn": "sub",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "sub",
            "framed": false,
            "expect": {
              "/id": "hello"
            }
          }
        },
        {
          "send": {
            "conn": "sub",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "subscribe",
                "method": "events.subscribe",
                "params": {
                  "filter": {
                    "terminals": null,
                    "children_of": null,
                    "labels": null,
                    "types": [
                      "doc.changed"
                    ],
                    "machines": null
                  },
                  "cursor": null,
                  "snapshot": false
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "sub",
            "expect": {
              "subscribe": {
                "/error": {
                  "$present": false
                },
                "/result/subscription_id": {
                  "$capture": "sub"
                },
                "/result/heartbeat_ms": {
                  "$present": true
                }
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "set",
                "method": "doc.set",
                "params": {
                  "op_id": "$op:doc",
                  "name": "watched",
                  "value": "one",
                  "version": "0",
                  "machine": null
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "set": {
                "/error": {
                  "$present": false
                }
              }
            }
          }
        },
        {
          "notification": {
            "conn": "sub",
            "method": "event",
            "expect": {
              "/params/type": "doc.changed",
              "/params/subscription_id": "$value:sub"
            }
          }
        },
        {
          "send": {
            "conn": "sub",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "update",
                "method": "events.update",
                "params": {
                  "subscription_id": "$value:sub",
                  "filter": {
                    "terminals": null,
                    "children_of": null,
                    "labels": null,
                    "types": [
                      "status.changed"
                    ],
                    "machines": null
                  }
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "sub",
            "expect": {
              "update": {
                "/error": {
                  "$present": false
                },
                "/result/subscription_id": "$value:sub",
                "/result/effective_seq": {
                  "$present": true
                }
              }
            }
          }
        },
        {
          "send": {
            "conn": "sub",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "unsubscribe",
                "method": "events.unsubscribe",
                "params": {
                  "subscription_id": "$value:sub"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "sub",
            "expect": {
              "unsubscribe": {
                "/error": {
                  "$present": false
                },
                "/result/seq": {
                  "$present": true
                },
                "/result/scan_seq": {
                  "$present": true
                }
              }
            }
          }
        },
        {
          "stop": {
            "expect": {
              "/panicked": "0"
            }
          }
        }
      ]
    },
    {
      "case": "failure",

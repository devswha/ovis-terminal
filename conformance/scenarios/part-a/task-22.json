      "steps": [
        {
          "serve": {
            "fixture": "assembled"
          }
        },
        {
          "connect": {
            "conn": "control",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "control",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/methods": {
                "$contains": [
                  "events.subscribe",
                  "events.update",
                  "events.unsubscribe"
                ]
              }
            }
          }
        },
        {
          "connect": {
            "conn": "sub",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "sub",
            "framed": false,
            "expect": {
              "/id": "hello"
            }
          }
        },
        {
          "send": {
            "conn": "sub",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "subscribe",
                "method": "events.subscribe",
                "params": {
                  "filter": {
                    "terminals": null,
                    "children_of": null,
                    "labels": null,
                    "types": [
                      "doc.changed"
                    ],
                    "machines": null
                  },
                  "cursor": null,
                  "snapshot": false
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "sub",
            "expect": {
              "subscribe": {
                "/error": {
                  "$present": false
                },
                "/result/subscription_id": {
                  "$capture": "sub"
                }
              }
            }
          }
        },
        {
          "connect": {
            "conn": "observer",
            "via": "socket",
            "principal": "observe"
          }
        },
        {
          "hello": {
            "conn": "observer",
            "framed": false,

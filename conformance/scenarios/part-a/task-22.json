              }
            }
          }
        },
        {
          "send": {
            "conn": "sub",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "unknown",
                "method": "events.update",
                "params": {
                  "subscription_id": "0191f1a2-0000-7000-8000-00000000dead",
                  "filter": {
                    "terminals": null,
                    "children_of": null,
                    "labels": null,
                    "types": [
                      "doc.changed"
                    ],
                    "machines": null
                  }
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "sub",
            "expect": {
              "unknown": {
                "/error/data/kind": "not_found"
              }
            }
          }
        },
        {
          "send": {
            "conn": "sub",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "closed",
                "method": "events.unsubscribe",
                "params": {
                  "subscription_id": "$value:sub"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "sub",
            "expect": {
              "closed": {
                "/error": {
                  "$present": false
                }
              }
            }
          }
        },
        {
          "send": {
            "conn": "sub",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "again",
                "method": "events.unsubscribe",
                "params": {
                  "subscription_id": "$value:sub"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "sub",
            "expect": {
              "again": {
                "/error/data/kind": "not_found"
              }

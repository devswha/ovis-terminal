              }
            ]
          }
        },
        {
          "replies": {
            "conn": "observer",
            "expect": {
              "foreign": {
                "/error/data/kind": "not_found"
              }
            }
          }
        },
        {
          "send": {
            "conn": "sub",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "unresolved",
                "method": "events.subscribe",
                "params": {
                  "filter": {
                    "terminals": null,
                    "children_of": [
                      "terminal:1"
                    ],

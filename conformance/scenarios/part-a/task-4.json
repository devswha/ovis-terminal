{
  "scenario": "part-a/task-4",
  "todo": 4,
  "title": "Generate OpenRPC and enforce released schema compatibility",
  "closes": [
    "GAP-018",
    "GAP-019",
    "GAP-139",
    "GAP-140"
  ],
  "delivers": [
    "IDEAL-008",
    "IDEAL-112",
    "IDEAL-113"
  ],
  "runner": "shell",
  "note": "Regenerates the OpenRPC document, checks byte stability against schema/ovis-terminal.openrpc.json and gates it against schema/released.openrpc.json. The real-socket rpc.discover transcript is added when the runner (todo 21) and the assembled binary (todo 31) exist.",
  "cases": [
    {
      "case": "happy",
      "steps": [
        {
          "argv": [
            "cargo",
            "test",
            "-p",
            "ovis-terminal-protocol",
            "--test",
            "schema",
            "happy",
            "--",
            "--exact",
            "--nocapture"
          ],
          "expect": {
            "exit": 0,
            "stdout_line": "test happy ... ok"
          }
        },
        {
          "argv": [
            "cargo",
            "run",
            "--locked",
            "--quiet",
            "-p",
            "ovis-terminal-protocol",
            "--bin",
            "openrpc",
            "--",
            "check",
            "schema/ovis-terminal.openrpc.json"
          ],
          "expect": {
            "exit": 0,
            "stdout_json": {
              "fresh": "schema/ovis-terminal.openrpc.json"
            }
          }
        },
        {
          "argv": [
            "cargo",
            "run",
            "--locked",
            "--quiet",
            "-p",
            "ovis-terminal-protocol",
            "--bin",
            "openrpc",
            "--",
            "compat",
            "schema/released.openrpc.json"
          ],
          "expect": {
            "exit": 0,
            "stdout_json": {
              "compatible_with": "schema/released.openrpc.json"
            }
          }
        }
      ]
    },
    {
      "case": "failure",
      "steps": [
        {
          "argv": [
            "cargo",
            "test",
            "-p",
            "ovis-terminal-protocol",
            "--test",
            "schema",
            "failure",
            "--",
            "--exact",
            "--nocapture"
          ],
          "expect": {
            "exit": 0,
            "stdout_line": "test failure ... ok"
          }
        }
      ]
    }
  ],
  "adversarial_cases": [
    {
      "class": "malformed input",
      "name": "unknown target property",
      "request_bytes": "{\"jsonrpc\":\"2.0\",\"id\":\"r1\",\"method\":\"terminal.get\",\"params\":{\"target\":{\"pane_id\":\"p1\"}}}\n",
      "expected": {
        "kind": "invalid_params",
        "jsonrpc_error_code": -32602,
        "field_path": "params.target.pane_id",
        "dispatch_count": 0
      }
    },
    {
      "class": "malformed input",
      "name": "numeric counter",
      "request_bytes": "{\"jsonrpc\":\"2.0\",\"id\":\"r2\",\"method\":\"terminal.history\",\"params\":{\"target\":{\"terminal_id\":\"t1\"},\"from_line\":5,\"limit\":10,\"format\":\"text\"}}\n",
      "expected": {
        "kind": "invalid_params",
        "field_path": "params.from_line",
        "dispatch_count": 0
      }
    },
    {
      "class": "stale state",
      "name": "new required request field against the released baseline",
      "fixture": "schema/fixtures/breaking-required-param.json",
      "expected": {
        "kind": "schema_incompatible",
        "rule": "required_param_added",
        "path": "terminal.get(pane_id)"
      }
    },
    {
      "class": "misleading success",
      "name": "stale checked-in document",
      "argv": [
        "cargo",
        "run",
        "--locked",
        "--quiet",
        "-p",
        "ovis-terminal-protocol",
        "--bin",
        "openrpc",
        "--",
        "check",
        "schema/released.openrpc.json"
      ],
      "precondition": "the checked-in file differs from the generated bytes",
      "expected": {
        "exit": 1,
        "stderr_json": {
          "kind": "schema_stale"
        }
      }
    },
    {
      "class": "misleading success",
      "name": "malformed released baseline",
      "argv": [
        "cargo",
        "run",
        "--locked",
        "--quiet",
        "-p",
        "ovis-terminal-protocol",
        "--bin",
        "openrpc",
        "--",
        "compat",
        "schema/fixtures/malformed-released.json"
      ],
      "expected": {
        "exit": 1,
        "stderr_json": {
          "kind": "malformed_baseline"
        },
        "stdout": ""
      }
    },
    {
      "class": "malformed input",
      "name": "self-referencing released baseline",
      "argv": [
        "cargo",
        "run",
        "--locked",
        "--quiet",
        "-p",
        "ovis-terminal-protocol",
        "--bin",
        "openrpc",
        "--",
        "compat",
        "schema/fixtures/cyclic-released.json"
      ],
      "expected": {
        "exit": 1,
        "stderr_json": {
          "kind": "schema_reference_cycle"
        }
      }
    }
  ]
}

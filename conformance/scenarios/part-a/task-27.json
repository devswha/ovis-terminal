{
  "format": "ovis-conformance/1",
  "scenario": "part-a/task-27",
  "title": "Atomic cursor waits and evidenced interrupt outcomes",
  "todo": 27,
  "closes": [
    "GAP-076",
    "GAP-077",
    "GAP-086"
  ],
  "delivers": [
    "IDEAL-026",
    "IDEAL-053",
    "IDEAL-054",
    "IDEAL-063"
  ],
  "excludes": [
    "EXCL-025",
    "EXCL-026"
  ],
  "platforms": [
    "linux",
    "macos"
  ],
  "cases": [
    {
      "case": "happy",
      "summary": "On a live program armed in holder order: a state wait nothing declares times out, input.interrupt writes ctrl+c with its receipt and reports the program stopped (turn ended), an exit wait is then already satisfied, and turn.get reports the open turn 0. Declared-status turn completion is asserted by the assembly test turns::declared_status_drives_state_and_turn_waits_and_an_interrupt_reports_its_key, which reads the program's process token from its own screen (no reply exposes it).",
      "steps": [
        {
          "serve": {
            "fixture": "assembled"
          }
        },
        {
          "connect": {
            "conn": "control",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "control",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/methods": {
                "$contains": [
                  "turn.wait",
                  "turn.get",
                  "events.wait",
                  "input.interrupt"
                ]
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "run",
                "method": "terminal.run",
                "params": {
                  "op_id": "$op:run",
                  "program": {
                    "argv": [
                      "/bin/sh",
                      "-c",
                      "printf 'ARMED\\n'; exec sleep 600"
                    ]
                  },
                  "geometry": {
                    "cols": 80,
                    "rows": 24
                  },
                  "cwd": "/tmp",
                  "env": {
                    "PATH": "/usr/bin:/bin",
                    "PS1": "$ ",
                    "TERM": "xterm"
                  },
                  "name": "sleeper",
                  "labels": null,
                  "parent": null,
                  "child_policy": null,
                  "keep": null,
                  "first_message": null,
                  "machine": null
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "run": {
                "/error": {
                  "$present": false
                },
                "/result/spawn": "spawned"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "armed",
                "method": "terminal.wait_output",
                "params": {
                  "target": {
                    "address": "t1"
                  },
                  "cursor": {
                    "offset": "0"
                  },
                  "pattern": {
                    "text": "ARMED"
                  },
                  "timeout_ms": "10000"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "armed": {
                "/error": {
                  "$present": false
                },
                "/result/outcome": "matched"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "quiet",
                "method": "events.wait",
                "params": {
                  "target": {
                    "address": "t1"
                  },
                  "states": [
                    "idle"
                  ],
                  "turn_after": null,
                  "exit": null,
                  "cursor": null,
                  "timeout_ms": "200"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "quiet": {
                "/error": {
                  "$present": false
                },
                "/result/outcome": "timeout"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "interrupt",
                "method": "input.interrupt",
                "params": {
                  "op_id": "$op:interrupt",
                  "target": {
                    "address": "t1"
                  },
                  "expect": null,
                  "key": null,
                  "observe_ms": "10000",
                  "lease_id": null
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "interrupt": {
                "/error": {
                  "$present": false
                },
                "/result/receipt/op_id": {
                  "$present": true
                },
                "/result/stopped": true,
                "/result/turn": "ended"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "exit",
                "method": "events.wait",
                "params": {
                  "target": {
                    "address": "t1"
                  },
                  "states": null,
                  "turn_after": null,
                  "exit": true,
                  "cursor": null,
                  "timeout_ms": "10000"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "exit": {
                "/error": {
                  "$present": false
                },
                "/result/outcome": "already_satisfied"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "turn",
                "method": "turn.get",
                "params": {
                  "target": {
                    "address": "t1"
                  }
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "turn": {
                "/error": {
                  "$present": false
                },
                "/result/turn": "0",
                "/result/outcome": null
              }
            }
          }
        },
        {
          "stop": {
            "expect": {
              "/panicked": "0"
            }
          }
        }
      ]
    },

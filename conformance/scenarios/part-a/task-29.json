      "case": "happy",
      "summary": "Through the binary's connect bridge, one framed connection carries every valid shared control frame the Bun SDK replays, answers each by id, and round-trips a document holding an offset above 2^53 and an unknown enum value byte-exactly.",
      "steps": [
        {
          "serve": {
            "fixture": "protocol"
          }
        },
        {
          "connect": {
            "conn": "bridge",
            "via": "bridge"
          }
        },
        {
          "hello": {
            "conn": "bridge",
            "framed": true,
            "expect": {
              "/id": "hello",
              "/result/machine_id": "machine:0191f1a2-0000-7000-8000-000000000021",
              "/result/capabilities/framed": true,
              "/result/limits/max_frame_bytes": "16777216"
            }
          }
        },
        {
          "send_wire": {
            "conn": "bridge",
            "frame": "control-request"
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "w1": {
                "/result/name": "alpha",
                "/result/value": null
              }
            }
          }
        },
        {
          "send_wire": {
            "conn": "bridge",
            "frame": "coalesced-requests"

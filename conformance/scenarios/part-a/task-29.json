        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "set-wide",
                "method": "doc.set",
                "params": {
                  "op_id": "$op:wide",
                  "name": "wide",
                  "value": {
                    "offset": "18446744073709551615",
                    "above_2_53": "9007199254740993",
                    "kind": "kind_from_a_newer_runtime"
                  },
                  "version": "0"
                }
              },
              {
                "jsonrpc": "2.0",
                "id": "page-at-max",
                "method": "terminal.output",
                "params": {
                  "target": {
                    "terminal_id": "terminal:1"
                  },
                  "from_offset": "18446744073709551615",
                  "limit_bytes": "4"
                }
              }
            ],
            "split": "bytewise"
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "set-wide": {
                "/result/value/offset": "18446744073709551615",
                "/result/value/above_2_53": "9007199254740993",
                "/result/value/kind": "kind_from_a_newer_runtime"
              },
              "page-at-max": {
                "/result/from_offset": "67108864",
                "/result/next_offset": "67108864",
                "/result/data_b64": ""
              }
            }
          }
        },
        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "get-wide",
                "method": "doc.get",
                "params": {
                  "name": "wide"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "get-wide": {
                "/result/value/offset": "18446744073709551615",
                "/result/value/above_2_53": "9007199254740993",

        },
        {
          "as": "operator",
          "rpc": "terminal.run",
          "params": {
            "op_id": "$uuidv7.replaced",
            "program": {
              "argv": [
                "/bin/sh",
                "-c",
                "printf 'ARMED\\n'; stty raw -echo; exec cat"
              ]
            },
            "cwd": "$isolated_root",
            "env": {
              "PATH": "/usr/bin:/bin"
            },
            "geometry": {

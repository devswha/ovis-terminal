        },
        {
          "as": "agent",
          "rpc": "input.send",
          "params": {
            "op_id": "$uuidv7.stale",
            "target": {
              "terminal_id": "$terminal_id"
            },
            "text": "stale",
            "submit": "none"
          },
          "assert": {
            "receipt.delivery.state": "queued"
          }
        },
        {
          "inject": {
            "fixture": "replace_process_while_queued",
            "target": {
              "terminal_id": "$terminal_id"
            }
          }
        },
        {
          "as": "agent",
          "rpc": "op.get",
          "params": {
            "op_id": "$uuidv7.stale"

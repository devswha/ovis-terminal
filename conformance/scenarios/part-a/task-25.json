        },
        {
          "as": "agent",
          "rpc": "input.send",
          "params": {
            "op_id": "$uuidv7.uncertain",
            "target": {
              "terminal_id": "$terminal_id"
            },
            "text": "uncertain",
            "submit": "none"
          }
        },
        {
          "inject": {
            "fixture": "drop_holder_link_after_dispatch",
            "target": {
              "terminal_id": "$terminal_id"
            }
          }
        },
        {
          "as": "agent",
          "rpc": "op.get",
          "params": {
            "op_id": "$uuidv7.uncertain"

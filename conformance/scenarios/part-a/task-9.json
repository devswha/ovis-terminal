  "adversarial_cases": [
    {
      "class": "malformed input",
      "name": "identity from wrong resource family",
      "test": "registry::ids::tests::malformed_identity_inputs_have_typed_kinds",
      "expected": {
        "kind": "invalid_identity",
        "resolved_target": false
      }
    },
    {
      "class": "stale state",
      "name": "PID reuse with an old start token",
      "test": "registry::failure",
      "expected": {
        "kind": "stale_target",
        "resolved_replacement": false
      }
    },
    {
      "class": "misleading success",
      "name": "same display name on different machines",
      "test": "registry::resolution::tests::target_resolution_returns_candidates_and_preserves_scoped_identity",
      "expected": {
        "kind": "ambiguous_target",
        "candidate_count": 2,
        "dispatch": false
      }
    },
    {
      "class": "error source preservation",
      "name": "malformed UUID and overflowing resource ID retain parser sources",
      "test": "registry::ids::tests::malformed_machine_uuid_preserves_source_and_kind + registry::ids::tests::malformed_resource_integer_preserves_source_and_kind",
      "expected": {
        "kind": "invalid_identity",
        "source": true
      }

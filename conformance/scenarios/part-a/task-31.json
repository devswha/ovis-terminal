      "case": "happy",
      "summary": "Real ovis-terminal serve runs /bin/sh as t1; ovis-terminal terminal attach --target t1 on a real outer PTY types a marker the shell evaluates, follows a resize the inner PTY reports, detaches on Ctrl-\\ with exit 0; the outer terminal settings equal the originals and attach.leases is empty afterwards; an unrouted method answers method_not_found.",
      "steps": [
        {
          "serve": {
            "fixture": "assembled"
          }
        },
        {
          "connect": {
            "conn": "control",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "control",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/methods": {
                "$contains": [
                  "attach.open",
                  "attach.resize",
                  "attach.leases",
                  "input.raw",
                  "terminal.run",
                  "terminal.get",
                  "server.status"
                ]
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "run",
                "method": "terminal.run",
                "params": {
                  "op_id": "$op:run",
                  "program": {
                    "argv": [
                      "/bin/sh"
                    ]
                  },
                  "geometry": {
                    "cols": 80,
                    "rows": 24
                  },
                  "cwd": "/tmp",
                  "env": {
                    "PATH": "/usr/bin:/bin",
                    "PS1": "$ ",
                    "TERM": "xterm"
                  },
                  "name": "shell",
                  "labels": null,
                  "parent": null,
                  "child_policy": null,
                  "keep": null,
                  "first_message": null,
                  "machine": null
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "run": {
                "/error": {
                  "$present": false
                },
                "/result/spawn": "spawned",
                "/result/terminal/address": "t1",
                "/result/terminal/state": "live"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "layout",
                "method": "layout.get",
                "params": {}

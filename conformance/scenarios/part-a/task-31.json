            "pty": "outer",
            "bytes": "echo mark-$((30+1))\r"
          }
        },
        {
          "pty_expect": {
            "pty": "outer",
            "output": "mark-31"
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "held",
                "method": "attach.leases",
                "params": {
                  "target": {
                    "address": "t1"
                  }
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "held": {
                "/result/interact/holder": "cli",
                "/result/geometry_owner/holder": "cli"
              }

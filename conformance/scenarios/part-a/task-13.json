  "adversarial_cases": [
    {
      "class": "malformed input",
      "name": "hello generation 999, numeric, non-canonical and u64::MAX+1 generations",
      "test": "conn::core::tests::generation_is_an_exact_decimal_string + failure",
      "expected": {
        "kind": "unsupported_generation|invalid_params",
        "mutations": 0
      }
    },
    {
      "class": "malformed input",
      "name": "unknown frame kind after the framed upgrade",
      "test": "adversarial::unknown_frame_kind_after_upgrade_closes_with_its_kind",
      "expected": {
        "closing_reason": "unknown_kind"
      }
    },
    {
      "class": "malformed input",
      "name": "bad envelope with a string id, then a line that is not JSON",
      "test": "adversarial::correlatable_bad_requests_are_answered_and_the_rest_close",
      "expected": {
        "kind": "invalid_request",
        "closing_reason": "parse_error"
      }
    },
    {
      "class": "stale state",
      "name": "socket path nobody listens on, or a plain marker file",
      "test": "failure + endpoint::a_stale_socket_is_replaced_and_a_plain_file_never_is",
      "expected": {
        "state": "stale_endpoint",
        "processes_started": 0
      }
    },
    {
      "class": "stale state",
      "name": "reconnect after a control-server restart",
      "test": "happy",
      "expected": {
        "continuity": "control_restarted",
        "runtime_lifetime": "unchanged"
      }
    },
    {
      "class": "stale state",
      "name": "expired, forged and absent credentials",
      "test": "adversarial::credentials_are_checked_before_hello_exposes_identity",
      "expected": {
        "kind": "credential_expired|invalid_credential|unauthenticated",
        "identity_exposed": false
      }
    },
    {
      "class": "cancel/resume",
      "name": "hello split at every byte with framed bytes behind it, and a half hello",
      "test": "conn::core::tests::framed_upgrade_parses_identically_under_every_split + conn::core::tests::partial_hello_establishes_nothing_until_its_line_completes",
      "expected": {
        "steps": [
          "ok:h",
          "upgrade",
          "dispatch:r1",
          "dispatch:r2"
        ]
      }
    },
    {
      "class": "cancel/resume",
      "name": "held requests at the in-flight bound when the server shuts down",
      "test": "adversarial::requests_beyond_the_in_flight_bound_get_backpressure_and_cancel_on_shutdown",
      "expected": {
        "kind": "backpressure",
        "cancelled": "all",
        "closing_reason": "server_shutdown"
      }
    }
  ]
}

  "adversarial_cases": [
    {
      "class": "stale state",
      "name": "revocation epoch advances while a decided write is queued on another thread",
      "test": "revocation::revocation_reaches_a_recheck_on_another_thread",
      "expected": {
        "kind": "credential_revoked",
        "written": false
      }
    },
    {
      "class": "stale state",
      "name": "decision from a previous authority instance or for a replaced incarnation",
      "test": "revocation::decision_from_another_authority_is_rejected + revocation::commit_must_match_the_decided_action_target_and_incarnation",
      "expected": {
        "kind": "decision_mismatch",
        "written": false
      }
    },
    {
      "class": "malformed input",
      "name": "forged scope document: unknown permission, unknown scope kind, smuggled field",
      "test": "issuance::forged_scope_documents_are_rejected_with_field_paths",
      "expected": {
        "kind": "invalid_params",
        "field_path": true
      }
    },
    {
      "class": "malformed input",
      "name": "forged bearer token: flipped, unknown id, truncated, uppercase secret",
      "test": "issuance::forged_bearer_tokens_are_rejected",
      "expected": {
        "kind": "invalid_credential",
        "authenticated": false
      }
    },
    {
      "class": "malformed input",
      "name": "numeric u64 counter instead of a decimal string",
      "test": "issuance::numeric_counter_is_rejected_with_its_field_path",
      "expected": {
        "kind": "invalid_params",
        "field_path": "expires_at_ms"
      }
    },
    {
      "class": "prompt injection",
      "name": "a well-formed grant document carried by an unprivileged principal",
      "test": "issuance::payload_from_an_unprivileged_principal_grants_nothing",
      "expected": {
        "kind": "forbidden",
        "granted": false
      }
    },
    {
      "class": "stale state",
      "name": "revoked credential's record reclaimed at capacity while its decision is queued",
      "test": "reclamation::queued_decision_stays_revoked_after_its_record_is_reclaimed + reclamation::tombstone_bound_holds_unexpired_revocations_until_one_expires",
      "expected": {
        "kind": "credential_revoked",
        "written": false
      }
    },
    {
      "class": "malformed input",
      "name": "registry identity of another family in a scope document",
      "test": "authority_scope::issuance_document_rejects_an_identity_of_another_family",
      "expected": {
        "kind": "invalid_params",
        "field_path": "grants[0].scope.resource"
      }
    },
    {
      "class": "stale state",
      "name": "decision queued while valid, then revoked, then expired, then its record or tombstone purged",
      "test": "reclamation::revoked_then_expired_decision_stays_revoked_after_table_overflow + reclamation::revoked_then_expired_decision_stays_revoked_after_tombstone_purge",
      "expected": {
        "kind": "credential_revoked",
        "written": false
      }
    }
  ]
}

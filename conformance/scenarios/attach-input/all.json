              "/result/limits/credit_max_bytes": "1048576",
              "/result/limits/input_queue_bytes": "16777216",
              "/result/limits/session_retained_bytes": "4294967296",
              "/result/limits/session_input_bytes": "67108864",
              "/result/limits/session_backlog_bytes": "67108864",

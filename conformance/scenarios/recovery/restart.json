              }
            }
          }
        },
        {
          "inject": {
            "conn": "control",
            "base": {
              "op_id": "$op:stop"
            },
            "planned": [
              {
                "request": {
                  "method": "server.stop",
                  "params": {
                    "scope": "everything-implicitly"
                  }
                },
                "expect": {
                  "/error/data/kind": "invalid_params",
                  "/error/data/field_path": "params.scope",
                  "/result": {
                    "$present": false
                  }
                }
              }
            ]
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "still",
                "method": "terminal.process_info",
                "params": {
                  "target": {
                    "address": "t1"
                  }
                }
              },
              {
                "jsonrpc": "2.0",
                "id": "served",

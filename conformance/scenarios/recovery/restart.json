{
  "format": "ovis-conformance/1",
  "scenario": "recovery/restart",
  "title": "Planned control restart keeps program incarnations and reports interrupted work",
  "todo": 48,
  "closes": [
    "GAP-065",
    "GAP-122",
    "GAP-126"
  ],
  "delivers": [
    "IDEAL-045",
    "IDEAL-094",
    "IDEAL-099",
    "IDEAL-117"
  ],
  "excludes": [
    "EXCL-016",
    "EXCL-021",
    "EXCL-026",
    "EXCL-027"
  ],
  "platforms": [
    "linux",
    "macos"
  ],
  "cases": [
    {
      "case": "happy",
      "summary": "Real ovis-terminal serve runs /bin/sh as t1; server.restart answers with both boots and one preserved incarnation, the old connection closes server_restart, the server announces the successor boot, and a new connection sees the same lifetime, the new boot and the same program pid.",
      "steps": [
        {
          "serve": {
            "fixture": "assembled"
          }
        },
        {
          "connect": {
            "conn": "control",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "control",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/methods": {
                "$contains": [
                  "server.restart",
                  "server.stop",
                  "server.status"
                ]
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "run",
                "method": "terminal.run",
                "params": {
                  "op_id": "$op:run",
                  "program": {
                    "argv": [
                      "/bin/sh"
                    ]
                  },
                  "geometry": {
                    "cols": 80,
                    "rows": 24
                  },
                  "cwd": "/tmp",
                  "env": {
                    "PATH": "/usr/bin:/bin",
                    "PS1": "$ ",
                    "TERM": "xterm"
                  },
                  "name": "shell",
                  "labels": null,
                  "parent": null,
                  "child_policy": null,
                  "keep": null,
                  "first_message": null,
                  "machine": null
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "run": {
                "/error": {
                  "$present": false
                },
                "/result/spawn": "spawned",
                "/result/terminal/address": "t1"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "status",
                "method": "server.status",
                "params": {}
              },
              {
                "jsonrpc": "2.0",
                "id": "before",
                "method": "terminal.process_info",
                "params": {
                  "target": {
                    "address": "t1"
                  }
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "status": {
                "/result/runtime_lifetime": {
                  "$capture": "lifetime"
                },
                "/result/server_boot_id": {
                  "$capture": "boot_old"
                },
                "/result/live_terminals": "1"
              },
              "before": {
                "/error": {
                  "$present": false
                },
                "/result/launcher/pid": {
                  "$capture": "pid"
                },
                "/result/launcher/start_token": {
                  "$capture": "token"
                }
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "restart",
                "method": "server.restart",
                "params": {
                  "op_id": "$op:restart"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "restart": {
                "/error": {
                  "$present": false
                },
                "/result/server_boot_id_old": "$value:boot_old",
                "/result/server_boot_id_new": {
                  "$capture": "boot_new"
                },
                "/result/ended_incarnations": [],
                "/result/preserved_incarnations/0": {
                  "$present": true
                },
                "/result/preserved_incarnations/1": {
                  "$present": false
                }
              }
            }
          }
        },
        {
          "notification": {
            "conn": "control",
            "method": "$/closing",
            "expect": {
              "/params/reason": "server_restart",
              "/params/incarnations_preserved": true
            }
          }
        },
        {
          "closed": {
            "conn": "control"
          }
        },
        {
          "announced": {
            "expect": {
              "/restarted/server_boot_id": "$value:boot_new",
              "/restarted/runtime_lifetime": "$value:lifetime"
            }
          }
        },
        {
          "connect": {
            "conn": "successor",
            "via": "socket"
          }
        },
        {
          "hello": {
            "conn": "successor",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/runtime_lifetime": "$value:lifetime",
              "/result/server_boot_id": "$value:boot_new"
            }
          }
        },
        {
          "send": {
            "conn": "successor",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "status",
                "method": "server.status",
                "params": {}
              },
              {
                "jsonrpc": "2.0",
                "id": "after",
                "method": "terminal.process_info",
                "params": {
                  "target": {
                    "address": "t1"
                  }
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "successor",
            "expect": {
              "status": {
                "/result/server_boot_id": "$value:boot_new",
                "/result/runtime_lifetime": "$value:lifetime",
                "/result/live_terminals": "1"
              },
              "after": {
                "/error": {
                  "$present": false
                },
                "/result/launcher/pid": "$value:pid",
                "/result/launcher/start_token": "$value:token"
              }
            }
          }
        },
        {
          "hangup": {
            "conn": "successor"
          }
        },
        {
          "closed": {
            "conn": "successor"
          }
        },
        {
          "stop": {
            "expect": {
              "/panicked": "0"
            }
          }
        }
      ]
    },
    {
      "case": "failure",
      "summary": "server.stop with an unknown scope is invalid_params at params.scope before any effect: the program keeps its pid and the boot keeps serving.",
      "steps": [
        {
          "serve": {
            "fixture": "assembled"
          }
        },
        {
          "connect": {
            "conn": "control",
            "via": "socket"
          }
        },
        {
          "hello": {

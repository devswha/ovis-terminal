            "expect": {
              "/id": "hello",
              "/result/methods": {
                "$contains": [
                  "server.restart",
                  "server.stop",
                  "server.status"
                ]
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "run",
                "method": "terminal.run",
                "params": {
                  "op_id": "$op:run",
                  "program": {
                    "argv": [
                      "/bin/sh"
                    ]
                  },
                  "geometry": {
                    "cols": 80,
                    "rows": 24
                  },
                  "cwd": "/tmp",
                  "env": {
                    "PATH": "/usr/bin:/bin",
                    "PS1": "$ ",
                    "TERM": "xterm"
                  },
                  "name": "shell",
                  "labels": null,
                  "parent": null,
                  "child_policy": null,
                  "keep": null,
                  "first_message": null,
                  "machine": null
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "control",
            "expect": {
              "run": {
                "/error": {
                  "$present": false
                },
                "/result/spawn": "spawned",
                "/result/terminal/address": "t1"
              }
            }
          }
        },
        {
          "send": {
            "conn": "control",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "status",
                "method": "server.status",
                "params": {}
              },
              {
                "jsonrpc": "2.0",
                "id": "before",
                "method": "terminal.process_info",
                "params": {

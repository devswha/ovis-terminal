{
  "format": "ovis-conformance/1",
  "scenario": "recovery/e2e",
  "title": "Remote faults settle as typed outcomes over real endpoints: a crashed peer mid-operation is outcome_unknown, a lost machine is machine_unreachable with its last seen sequence, a failed plugin is a durable failed run",
  "todo": 52,
  "closes": [
    "GAP-108",
    "GAP-118"
  ],
  "delivers": [
    "IDEAL-082",
    "IDEAL-091",
    "IDEAL-117"
  ],
  "excludes": [
    "EXCL-020",
    "EXCL-021"
  ],
  "platforms": [
    "linux",
    "macos"
  ],
  "cases": [
    {
      "case": "happy",
      "summary": "Planned replacement of the peer runtime: after the peer and the local runtime each run a program named parent, fixture.peer restart stops the peer process and starts a fresh one, which proves the same machine id over a fresh challenge and takes the same actor (line epoch 2, no orphan notice left to replay). The peer's parent incarnation is lost on the new runtime (incarnation 0, not live), the local parent is preserved (incarnation 1, live, no kills), and a new terminal.run on the peer starts incarnation 1 there.",
      "steps": [
        {
          "serve": {
            "fixture": "protocol"
          }
        },
        {
          "connect": {
            "conn": "bridge",
            "via": "bridge"
          }
        },
        {
          "hello": {
            "conn": "bridge",
            "framed": false,
            "expect": {
              "/id": "hello",
              "/result/machine_id": "machine:0191f1a2-0000-7000-8000-000000000021"
            }
          }
        },
        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "describe",
                "method": "fixture.peer",
                "params": {
                  "action": "describe"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "describe": {
                "/error": {
                  "$present": false
                },
                "/result/machine_id": "machine:0191f1a2-0000-7000-8000-0000000000c3",
                "/result/argv": {
                  "$capture": "peer_argv"
                },
                "/result/credential": {
                  "$capture": "peer_credential"
                }
              }
            }
          }
        },
        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "add-peer",
                "method": "machine.add",
                "params": {
                  "op_id": "$op:add-peer",
                  "name": "peer",
                  "transport": {
                    "argv": "$value:peer_argv"
                  },
                  "credential": "$value:peer_credential",
                  "expected_machine_id": "machine:0191f1a2-0000-7000-8000-0000000000c3"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
            "expect": {
              "add-peer": {
                "/error": {
                  "$present": false
                },
                "/result/machine_id": "machine:0191f1a2-0000-7000-8000-0000000000c3",
                "/result/name": "peer",
                "/result/state": "connected"
              }
            }
          }
        },
        {
          "send": {
            "conn": "bridge",
            "requests": [
              {
                "jsonrpc": "2.0",
                "id": "run-local",
                "method": "terminal.run",
                "params": {
                  "op_id": "$op:run-local",
                  "program": {
                    "argv": [
                      "agent"
                    ]
                  },
                  "geometry": {
                    "cols": 80,
                    "rows": 24
                  },
                  "name": "parent"
                }
              }
            ]
          }
        },
        {
          "replies": {
            "conn": "bridge",
